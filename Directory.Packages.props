<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="SkiaSharp" Version="4.154.0" />
    <!-- Linux has no system Skia: the server bundles it without fontconfig, since it never draws text. -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.154.0" />
    <!-- Aurelia for Linux (clients/linux): C# with the Avalonia interface toolkit. -->
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Wayland" Version="12.1.4" />
    <!-- Playback in Aurelia for Linux: the distribution's VLC (libVLC 3) through LibVLCSharp. -->
    <PackageVersion Include="LibVLCSharp" Version="3.10.2" />
    <!-- The D-Bus library Avalonia itself uses, for the keyring (Secret Service) and media keys (MPRIS). -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.94.1" />
    <!-- Ed25519 and BLAKE2b for checking the minisign signature of Linux app updates. -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.5.0" />
    <!-- Avalonia's headless test runner is built on xUnit v3; the server tests stay on v2. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="Haukcode.Mdns" Version="1.0.22" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
