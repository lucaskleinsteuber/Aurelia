<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <!-- Desktop client (clients/desktop) -->
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <!-- Video playback in the desktop client: VLC through LibVLCSharp, with each platform's VLC build. -->
    <PackageVersion Include="LibVLCSharp" Version="3.10.1" />
    <PackageVersion Include="VideoLAN.LibVLC.Mac" Version="3.1.3.2" />
    <PackageVersion Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <!-- Avalonia's headless test runner is built on xUnit v3; the server tests stay on v2. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="Haukcode.Mdns" Version="1.0.18" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
