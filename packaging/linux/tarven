#!/bin/bash
# The tarven command on a Linux server: sets it up over SSH, approves devices and passes
# library, pairing and server commands to the installed Tarven Server.
set -euo pipefail

install_root=/opt/tarven
server="$install_root/server/Tarven.Server"
data_dir=/var/lib/tarven

require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "Run this with sudo: sudo tarven $*" >&2
    exit 1
  fi
}

wait_until_ready() {
  for _ in $(seq 1 60); do
    if "$server" server identity >/dev/null 2>&1; then return 0; fi
    sleep 1
  done
  echo "Tarven Server did not start. See: tarven logs" >&2
  return 1
}

# Power saving may have stopped Tarven Server; connecting to its local port starts it again.
ensure_running() {
  systemctl is-active --quiet tarven && return 0
  if ! systemctl is-active --quiet tarven-start.socket; then
    echo "Tarven Server is stopped. Start it with: sudo tarven start" >&2
    return 1
  fi
  (exec 3<>/dev/tcp/127.0.0.1/43110) 2>/dev/null || true
  wait_until_ready
}

# Updates come from the GitHub Releases of the repository the package was built from. A private
# repository needs a read-only token, which only root may read.
token_file=/etc/tarven/github-token
# "beta" here also offers GitHub pre-releases (test versions); set with: sudo tarven update --beta on
channel_file=/etc/tarven/update-channel
# Stand-ins for GitHub are honoured only where root asked for them with this file (the package
# tests): with `sudo -E`, a user's own variables must not choose what root installs (audit S-X18).
if [ ! -f /etc/tarven/test-update-source ] || [ -L /etc/tarven/test-update-source ]; then
  unset TARVEN_UPDATE_API TARVEN_UPDATE_REPOSITORY TARVEN_UPDATE_SIGNING_KEY
fi
update_api=${TARVEN_UPDATE_API:-https://api.github.com}
update_repository=${TARVEN_UPDATE_REPOSITORY:-$(cat "$install_root/REPOSITORY" 2>/dev/null || true)}
update_token=""
# The owner's minisign key, the same that signs Tarven for Linux (docs/LINUX_UPDATE_SIGNING.md).
# Every release's SHA256SUMS must carry its signature, old builds included, so a changed GitHub
# release installs nothing. Tests with a stand-in for GitHub sign with their own key.
signing_public_key=RWT0nYptHNjXQSXnVurY9XXdPF2Ssq5sUlSP+WoBwjA5GPXWnugBc7lE
[ -n "${TARVEN_UPDATE_API:-}" ] && signing_public_key=${TARVEN_UPDATE_SIGNING_KEY:-$signing_public_key}

# Succeeds when $2 is a minisign signature of $1 made with signing_public_key, checked with
# openssl so that no further program is needed. Only the prehashed form that minisign writes is
# accepted. $3 is an empty folder for the intermediate files.
signature_valid() {
  local file=$1 signature=$2 scratch=$3
  base64 -d <<<"$signing_public_key" > "$scratch/key.bin" 2>/dev/null || return 1
  sed -n 2p "$signature" | base64 -d > "$scratch/signature.bin" 2>/dev/null || return 1
  [ "$(wc -c < "$scratch/key.bin")" -eq 42 ] && [ "$(wc -c < "$scratch/signature.bin")" -eq 74 ] || return 1
  [ "$(head -c 2 "$scratch/key.bin")" = Ed ] && [ "$(head -c 2 "$scratch/signature.bin")" = ED ] || return 1
  [ "$(head -c 10 "$scratch/key.bin" | tail -c 8 | od -An -tx1)" \
    = "$(head -c 10 "$scratch/signature.bin" | tail -c 8 | od -An -tx1)" ] || return 1
  { printf '\060\052\060\005\006\003\053\145\160\003\041\000'; tail -c 32 "$scratch/key.bin"; } > "$scratch/key.der"
  tail -c 64 "$scratch/signature.bin" > "$scratch/signature.raw"
  openssl dgst -blake2b512 -binary "$file" > "$scratch/hash" 2>/dev/null || return 1
  openssl pkeyutl -verify -pubin -keyform DER -inkey "$scratch/key.der" -rawin -in "$scratch/hash" \
    -sigfile "$scratch/signature.raw" >/dev/null 2>&1
}

# Saves a GitHub address to a file and prints the HTTP status. The token reaches curl through its
# standard input, so it never shows up in the process list, and curl drops it when GitHub
# redirects a download to its file storage.
github_fetch() {
  local url=$1 output=$2 accept=${3:-application/vnd.github+json} protocols="=https"
  # Tests point the updater at a local stand-in for GitHub.
  [ -n "${TARVEN_UPDATE_API:-}" ] && protocols="=http,https"
  {
    [ -z "$update_token" ] || printf 'header = "Authorization: Bearer %s"\n' "$update_token"
  } | curl -sSL --proto "$protocols" --proto-redir "$protocols" --connect-timeout 15 --max-time 1800 \
    --speed-limit 1024 --speed-time 60 --retry 2 \
    -H "Accept: $accept" -H "X-GitHub-Api-Version: 2022-11-28" -K - -o "$output" -w '%{http_code}' "$url" \
    || true
}

# Tells the app what `tarven update` found or does. Tarven Server reads update-status from its
# data folder, so the file belongs to the server's user; values stay plain and short.
report_update=false
update_status_final=false
status_newest_version="" status_newest_build="" status_target="" status_checked_at=""
status_progress="" status_phase=""
write_update_status() {
  local state=$1 message=${2:-} progress=${3:-$status_progress} phase=${4:-$status_phase}
  $report_update || return 0
  if [ "$state" = idle ] || [ "$state" = failed ]; then
    update_status_final=true
    progress=""
    phase=""
  fi
  message=$(printf '%s' "$message" | tr -cd '[:print:]' | cut -c1-200)
  # Written as the server's user: root changing owners in that user's folder could be led along
  # a link onto any file of the computer.
  printf 'STATE=%s\nCHANGED_AT=%s\nCHECKED_AT=%s\nNEWEST_VERSION=%s\nNEWEST_BUILD=%s\nTARGET_BUILD=%s\nPROGRESS=%s\nPHASE=%s\nMESSAGE=%s\n' \
    "$state" "$(date +%s)" "$status_checked_at" "$status_newest_version" "$status_newest_build" "$status_target" \
    "$progress" "$phase" "$message" \
    | runuser -u tarven -- /bin/sh -c 'umask 077; t=$(mktemp "$1.XXXXXX") && cat > "$t" && mv -f "$t" "$1"' sh "$data_dir/update-status" \
    || true
}

# Draws a single-line progress bar when stderr is an interactive terminal (`sudo tarven update`).
terminal_bar_active=false
show_update_bar() {
  local pct=$1 label=$2 filled empty bar=""
  [ -t 2 ] || return 0
  [ "$pct" -lt 0 ] && pct=0
  [ "$pct" -gt 100 ] && pct=100
  filled=$(( pct * 30 / 100 ))
  empty=$(( 30 - filled ))
  bar=$(printf '%*s' "$filled" '' | tr ' ' '#')$(printf '%*s' "$empty" '' | tr ' ' '-')
  printf '\r  [%s] %3d%%  %-46.46s' "$bar" "$pct" "$label" >&2
  terminal_bar_active=true
}

end_update_bar() {
  if $terminal_bar_active; then
    printf '\n' >&2
    terminal_bar_active=false
  fi
}

# Downloads the server archive while updating both the terminal progress bar and update-status.
github_fetch_package() {
  local url=$1 output=$2 expected_bytes=${3:-0} label=${4:-package} status_file="$work/fetch_status"
  rm -f "$status_file" "$output"
  ( github_fetch "$url" "$output" application/octet-stream > "$status_file" ) &
  local fetch_pid=$! last_written=-1 now=0
  while kill -0 "$fetch_pid" 2>/dev/null; do
    if [ "$expected_bytes" -gt 0 ] && [ -f "$output" ]; then
      local current_bytes
      current_bytes=$(wc -c < "$output" 2>/dev/null | tr -d '[:space:]' || echo 0)
      if [[ "$current_bytes" =~ ^[0-9]+$ ]] && [ "$current_bytes" -gt 0 ]; then
        local dl_pct=$(( current_bytes * 100 / expected_bytes ))
        [ "$dl_pct" -gt 100 ] && dl_pct=100
        local overall=$(( 15 + dl_pct * 65 / 100 ))
        local mb_done=$(( current_bytes / 1048576 )) mb_total=$(( expected_bytes / 1048576 ))
        show_update_bar "$overall" "Downloading $label (${mb_done}/${mb_total} MB)"
        now=$(date +%s)
        if [ "$overall" != "$status_progress" ] && [ $(( now - last_written )) -ge 1 ]; then
          status_progress=$overall status_phase=downloading
          write_update_status installing
          last_written=$now
        fi
      fi
    fi
    sleep 0.3
  done
  wait "$fetch_pid" || true
  cat "$status_file" 2>/dev/null || true
}

github_failure() {
  case "$1" in
    401) echo "GitHub refused the token; it may have expired. Save a new one: sudo tarven update --set-token" ;;
    403|429) echo "GitHub refused $2 for now (too many requests or no access). Try again later." ;;
    404)
      if [ -n "$update_token" ]; then
        echo "GitHub did not find $2. Check that the token may read $update_repository."
      else
        echo "GitHub did not find $2. A private repository needs a token: sudo tarven update --set-token"
      fi ;;
    000|"") echo "GitHub could not be reached. Check the internet connection." ;;
    *) echo "GitHub answered $2 with status $1." ;;
  esac
}

github_failed() {
  local message
  message=$(github_failure "$@")
  echo "$message" >&2
  write_update_status failed "$message"
  exit 1
}

# The published release with the highest build that has a package for this computer ($arch) and
# a checksum list, as build, version, file name, file, checksum and signature addresses (the last
# empty without a signature); drafts are skipped, and pre-releases unless the beta channel is on.
# Prints nothing when there is none.
newest_package() {
  jq -r --arg arch "$arch" --argjson beta "${beta_updates:-false}" '
    [ .[] | select((.draft | not) and ($beta or (.prerelease | not)))
      | (.assets // []) as $assets
      | first($assets[] | select(.name == "SHA256SUMS") | .url) as $sums
      | (first($assets[] | select(.name == "SHA256SUMS.minisig") | .url) // "") as $signature
      | $assets[]
      | (.name | capture("^Tarven-Server-(?<version>[0-9][0-9.]*)-(?<build>[0-9]+)-linux-" + $arch + "\\.tar\\.gz$")) as $found
      | [($found.build | tonumber), $found.version, .name, .url, $sums, $signature] ]
    | max_by(.[0]) // empty | .[0] |= tostring | join("\t")' "$1"
}

usage() {
  cat <<'USAGE'
Tarven Server

  sudo tarven setup [--name "Server Name"] [--power always|save|stop-only] [--browser | --terminal]
                                              --browser: set up in a web browser with a one-time code
                                              Create the owner, turn on network access, choose power use
  sudo tarven setup --move                   Move here from another Tarven server: over the network
                                              with its move code, or with a moving file
  tarven move code                           On the old server: show a move code for the new one
  tarven move export FILE                    On the old server: write an encrypted moving file
  tarven move status                         Is this server moving, or where did it move
  sudo tarven move undo                      This server answers devices again (new one off first)
  tarven pair                                Show a code to type on a new device (Mac, Linux PC,
                                              Apple TV, iPhone, iPad or browser)
  tarven approve [CODE]                      Allow an older app that shows a code itself
  tarven library add --path PATH [--kind automatic|movies|tv] [--name NAME]
  tarven library list | scan --all | remove --id ID --yes
  tarven status                              Is the server running, and its fingerprint
  sudo tarven sleep on [--idle MINUTES] [--awake 17:00-23:30|off]
                                              Computer sleeps when unused; Wake-on-LAN wakes it
  sudo tarven sleep server [--idle MINUTES] [--awake ...]
  sudo tarven sleep shutdown [--idle MINUTES] [--awake ...]
                                              Computer turns off when unused; Wake-on-LAN starts it
                                              (on and shutdown: --wake-on-access on|off also wakes it
                                              when a device such as a browser connects directly;
                                              --after-sleep-timer off ignores players' sleep timers)
                                              Only Tarven stops; a device starts it again
  sudo tarven sleep off | status             Also in Tarven's server settings on a Mac
  tarven logs                                Follow the server log (Ctrl+C ends)
  sudo tarven restart | start | stop
  tarven version
  sudo tarven update [--check] [--yes]       Install the newest version from GitHub
  sudo tarven update --set-token             Save the GitHub token a private download needs
  sudo tarven update --beta on|off           Also install test versions (pre-releases)
                                              Updates can also be installed in Tarven on a Mac
  sudo tarven uninstall [--remove-data]      Server data stays unless --remove-data

Commands that change the server ask for the owner's name, Server Password and PIN.
USAGE
}

# Reads the browser setup code only from a plain non-symlink file and strips control characters (audit LNX-PKG-011).
read_setup_code() {
  local path="$data_dir/browser-setup-code"
  [ -f "$path" ] && [ ! -L "$path" ] || return 0
  head -c 64 "$path" 2>/dev/null | tr -cd 'A-Za-z0-9-' | cut -c1-32
}

# The addresses and the one-time code for setting this server up in a browser.
show_browser_setup() {
  local code="" tries=0
  while [ -z "$code" ] && [ $tries -lt 20 ]; do
    code=$(read_setup_code)
    [ -n "$code" ] || { sleep 0.5; tries=$((tries + 1)); }
  done
  if [ -z "$code" ]; then
    echo "No setup code: this server already has an owner, or it isn't running. Run: sudo tarven status" >&2
    return 1
  fi
  echo "Set up Tarven in a web browser on any computer, phone or tablet at home:"
  for address in $(hostname -I 2>/dev/null); do
    case "$address" in *:*) continue ;; esac
    echo "  https://$address:43111"
  done
  echo
  echo "  Setup code: $code"
  echo
  echo "The browser warns about the certificate the first time; that is expected. The page shows"
  echo "the same verification fingerprint as 'tarven status' if you want to compare."
  "$server" server identity 2>/dev/null | grep -i fingerprint || true
}

command=${1:-help}
[ $# -gt 0 ] && shift

case "$command" in
  setup)
    require_root setup
    name=""
    power=""
    way=""
    kind=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --name)
          [ $# -ge 2 ] || { echo "--name needs a value." >&2; exit 2; }
          name=$2; shift 2 ;;
        --power)
          [ $# -ge 2 ] || { echo "--power needs a value." >&2; exit 2; }
          power=$2; shift 2 ;;
        --browser) way=browser; kind=new; shift ;;
        --terminal) way=terminal; kind=new; shift ;;
        --move) kind=move; shift ;;
        *) echo "Unknown option: $1" >&2; exit 2 ;;
      esac
    done
    if [ -z "$kind" ]; then
      echo "Set up a new server or move from another Tarven server?"
      echo "  1) Set up a new server"
      echo "  2) Move from another Tarven server: its library, settings, profiles and signed-in devices"
      echo "     come along; the media files stay where they are"
      read -r -p "Choose 1 or 2 [1]: " kind || kind=""
      case "${kind:-1}" in 2|move) kind=move ;; *) kind=new ;; esac
    fi
    if [ "$kind" = move ]; then
      # A fresh start makes a fresh setup code, which the move uses on this computer only.
      # Run as tarven so root never reads or forwards a symlinked file from the server data folder (audit LNX-PKG-011).
      systemctl stop tarven-start.socket tarven 2>/dev/null || true
      systemctl start tarven
      wait_until_ready
      (cd "$data_dir" && runuser -u tarven -- "$server" move receive --data-dir "$data_dir") || exit 1
      echo
      echo "Choose how much power this computer uses with: sudo tarven sleep (always on unless changed)"
      exit 0
    fi
    if [ -z "$way" ]; then
      echo "How do you want to set up Tarven?"
      echo "  1) In a web browser on any computer, phone or tablet at home (recommended)"
      echo "  2) Here in the terminal"
      read -r -p "Choose 1 or 2 [1]: " way || way=""
      case "${way:-1}" in 2|terminal) way=terminal ;; *) way=browser ;; esac
    fi
    if [ "$way" = browser ]; then
      systemctl stop tarven-start.socket tarven 2>/dev/null || true
      arguments=(setup-browser --data-dir "$data_dir")
      [ -n "$name" ] && arguments+=(--server-name "$name")
      if ! (cd "$data_dir" && runuser -u tarven -- "$server" "${arguments[@]}"); then
        systemctl start tarven
        exit 1
      fi
      systemctl start tarven
      wait_until_ready
      show_browser_setup
      exit 0
    fi
    read -r -p "Owner name (used to sign in): " owner
    [ -n "$owner" ] || { echo "An owner name is required." >&2; exit 2; }
    systemctl stop tarven-start.socket tarven
    arguments=(setup-owner --headless --data-dir "$data_dir" --username "$owner" --device-name "$(hostname)")
    [ -n "$name" ] && arguments+=(--server-name "$name")
    # The tarven user may not read the caller's folder, so the server starts in its own.
    if ! (cd "$data_dir" && runuser -u tarven -- "$server" "${arguments[@]}"); then
      systemctl start tarven
      exit 1
    fi
    # The owner exists now, so the browser setup code is no longer needed.
    rm -f "$data_dir/browser-setup-code"
    systemctl start tarven
    wait_until_ready
    "$server" server identity
    # One question instead of the power settings: the answer sets them up.
    if [ -z "$power" ]; then
      echo
      echo "Should this computer stay on all the time?"
      echo "  1) Always on: Tarven is ready at any moment. Uses the most power."
      echo "  2) Save power: the computer sleeps after 15 unused minutes. Tarven on a Mac,"
      echo "     or a router such as a FRITZ!Box, wakes it again (Wake-on-LAN)."
      echo "  3) Stop only Tarven: for a computer that also does other work, such as a NAS."
      echo "     Tarven starts again within seconds when a device connects."
      read -r -p "Choose 1, 2 or 3 [1]: " power || power=""
    fi
    echo
    case "${power:-1}" in
      2|save) "$0" sleep on --idle 15 --awake off ;;
      3|stop-only) "$0" sleep server --idle 15 --awake off ;;
      1|always) "$0" sleep off ;;
      *) echo "Unknown choice; Tarven stays always on." >&2; "$0" sleep off ;;
    esac
    echo "Change this any time in a browser (Settings › Power), in Tarven on a Mac or with: sudo tarven sleep"
    echo
    echo "Next, connect your devices. The first one also asks for the owner's new viewing PIN."
    echo "  Run here: tarven pair, then type the code in Tarven on the new device"
    echo "  (Mac, Linux PC, Apple TV, iPhone, iPad, or this server's address in a browser)."
    ;;
  approve)
    ensure_running
    if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
      code=$1
      shift
      exec "$server" pairing approve --code "$code" "$@"
    fi
    exec "$server" pairing approve "$@"
    ;;
  pair)
    ensure_running
    exec "$server" pairing create "$@"
    ;;
  library|pairing|metadata)
    ensure_running
    exec "$server" "$command" "$@"
    ;;
  move)
    # Moving to a new server (docs/SERVER_MOVE.md). code, export, status and undo sign in as the
    # owner; receive is what `sudo tarven setup --move` runs on the new server.
    case "${1:-}" in
      receive) require_root move receive; ensure_running; cd "$data_dir"; exec runuser -u tarven -- "$server" move receive --data-dir "$data_dir" ;;
      code|export|status|undo) ensure_running; exec "$server" move "$@" ;;
      *) echo "Use: tarven move code | export FILE | status | undo" >&2; exit 2 ;;
    esac
    ;;
  sleep)
    action=${1:-status}
    [ $# -gt 0 ] && shift
    # The settings sit in the server's private data folder, which only root and the server read.
    require_root sleep "$action"
    settings="$data_dir/sleep-settings"
    . "$install_root/tarven-sleep-settings"
    read_sleep_settings "$settings"
    case "$action" in
      on|server|shutdown)
        while [ $# -gt 0 ]; do
          case "$1" in
            --idle)
              [ $# -ge 2 ] || { echo "--idle needs a number of minutes from 5 to 1440." >&2; exit 2; }
              IDLE_MINUTES=$2; shift 2 ;;
            --wake-on-access)
              [ $# -ge 2 ] || { echo "--wake-on-access needs on or off." >&2; exit 2; }
              case "$2" in on|off) WAKE_ON_ACCESS=$2 ;; *) echo "--wake-on-access needs on or off." >&2; exit 2 ;; esac
              shift 2 ;;
            --after-sleep-timer)
              [ $# -ge 2 ] || { echo "--after-sleep-timer needs on or off." >&2; exit 2; }
              case "$2" in on|off) AFTER_SLEEP_TIMER=$2 ;; *) echo "--after-sleep-timer needs on or off." >&2; exit 2 ;; esac
              shift 2 ;;
            --awake)
              [ $# -ge 2 ] || { echo "--awake needs HH:MM-HH:MM, for example 17:00-23:30, or off." >&2; exit 2; }
              if [ "$2" = off ]; then AWAKE_FROM="" AWAKE_UNTIL=""; else AWAKE_FROM=${2%%-*} AWAKE_UNTIL=${2##*-}; fi
              shift 2 ;;
            *) echo "Unknown option: $1" >&2; exit 2 ;;
          esac
        done
        [[ "$IDLE_MINUTES" =~ ^[0-9]{1,5}$ ]] && (( 10#$IDLE_MINUTES >= 5 && 10#$IDLE_MINUTES <= 1440 )) \
          || { echo "--idle needs a number of minutes from 5 to 1440." >&2; exit 2; }
        IDLE_MINUTES=$(( 10#$IDLE_MINUTES ))
        if [ -n "$AWAKE_FROM$AWAKE_UNTIL" ]; then
          for time in "$AWAKE_FROM" "$AWAKE_UNTIL"; do
            [[ "$time" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || { echo "--awake needs HH:MM-HH:MM, for example 17:00-23:30, or off." >&2; exit 2; }
          done
          [ "$AWAKE_FROM" != "$AWAKE_UNTIL" ] || { echo "--awake needs a different start and end." >&2; exit 2; }
        fi
        case "$action" in server) MODE=stop ;; shutdown) MODE=shutdown ;; *) MODE=sleep ;; esac
        if [ "$MODE" = sleep ] && ! grep -qw mem /sys/power/state 2>/dev/null; then
          echo "Suspend to RAM is not supported on this computer. Use 'sudo tarven sleep server' or 'sudo tarven sleep shutdown'." >&2
          exit 1
        fi
        write_sleep_settings "$settings"
        systemctl enable --now tarven-autosleep.timer >/dev/null
        if [ "$MODE" = stop ]; then
          echo "Power saving is on. Tarven Server stops five minutes after a player's sleep timer ends, and"
          if [ -n "$AWAKE_FROM" ]; then
            echo "after $IDLE_MINUTES unused minutes outside $AWAKE_FROM-$AWAKE_UNTIL. The computer stays on, and Tarven"
          else
            echo "after $IDLE_MINUTES unused minutes. The computer stays on, and Tarven"
          fi
          echo "starts again within seconds when a Mac or Apple TV connects."
          exit 0
        fi
        if ! command -v ethtool >/dev/null 2>&1 && command -v apt-get >/dev/null 2>&1; then
          apt-get install -y ethtool >/dev/null
        fi
        systemctl enable --now tarven-wake-on-lan.service >/dev/null 2>&1 || echo "Wake-on-LAN could not be turned on; see: journalctl -u tarven-wake-on-lan" >&2
        if [ "$MODE" = shutdown ]; then
          echo "Shut-down mode is on. The computer turns off five minutes after a player's sleep timer ends, and after"
        else
          echo "Sleep mode is on. The server sleeps five minutes after a player's sleep timer ends, and after"
        fi
        if [ -n "$AWAKE_FROM" ]; then
          echo "$IDLE_MINUTES unused minutes outside $AWAKE_FROM-$AWAKE_UNTIL. It wakes itself at $AWAKE_FROM; Tarven on a"
        else
          echo "$IDLE_MINUTES unused minutes, at any time of day. Tarven on a"
        fi
        echo "Mac wakes it when you open it, and a router such as a Fritzbox can wake it too (Wake-on-LAN)."
        if [ "$WAKE_ON_ACCESS" = on ]; then
          echo "It also wakes when a device that reached it shortly before connects directly, such as a browser."
        fi
        if [ "$MODE" = shutdown ]; then
          echo "Starting takes about a minute, and the BIOS must allow Wake-on-LAN while the computer is off."
        else
          echo "Some computers also need Wake-on-LAN allowed in the BIOS."
        fi
        ;;
      off)
        MODE=off
        write_sleep_settings "$settings"
        rm -f "$data_dir/sleep-ready"
        if ! systemctl is-active --quiet tarven; then systemctl start tarven; fi
        echo "Power saving is off; the server keeps running. Wake-on-LAN stays allowed."
        ;;
      status)
        if [ "$MODE" != off ]; then
          hours=""
          [ -n "$AWAKE_FROM" ] && hours=" outside $AWAKE_FROM-$AWAKE_UNTIL"
          what="the computer sleeps"
          [ "$MODE" = stop ] && what="only Tarven stops"
          [ "$MODE" = shutdown ] && what="the computer turns off"
          echo "Power saving: $what (5 minutes after a sleep timer; after $IDLE_MINUTES unused minutes$hours)"
          [ "$MODE" != stop ] && [ "$WAKE_ON_ACCESS" = on ] && echo "Wakes when a device connects directly: on"
          scratch=$(mktemp -d)
          [ -r /run/tarven-autosleep/last-active ] && cp /run/tarven-autosleep/last-active "$scratch/"
          [ -r /run/tarven-autosleep/woke ] && cp /run/tarven-autosleep/woke "$scratch/"
          echo "Right now: $(TARVEN_AUTOSLEEP_DRY_RUN=1 TARVEN_AUTOSLEEP_STATE="$scratch" "$install_root/tarven-autosleep" 2>/dev/null || echo "unknown")"
          rm -rf "$scratch"
        else
          echo "Power saving: off"
        fi
        device=$(ip -4 route show default | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
        if [ -n "$device" ]; then
          echo "Wake address: $(cat "/sys/class/net/$device/address") ($device)"
          wake_now=$( { ethtool "$device" 2>/dev/null || true; } | awk -F': ' '/^[[:space:]]*Wake-on:/ { print $2; exit }')
          case "$wake_now" in
            *g*) echo "Wake-on-LAN: on" ;;
            "") echo "Wake-on-LAN: unknown (ethtool can't read this card)" ;;
            *) echo "Wake-on-LAN: off right now; restart the computer once, or run: sudo systemctl restart tarven-wake-on-lan" ;;
          esac
          [ -e "/sys/class/net/$device/wireless" ] && echo "Connected by Wi-Fi: almost no computer can be woken over Wi-Fi. Use a network cable."
        fi
        if grep -qw mem /sys/power/state 2>/dev/null; then
          if [ ! -r /sys/power/mem_sleep ] || grep -q '\[deep\]' /sys/power/mem_sleep; then
            echo "Sleep: suspend to RAM (fans and disks stop; waking takes seconds)"
          else
            echo "Sleep: only light sleep (s2idle); test once whether Wake-on-LAN wakes it"
          fi
        else
          echo "Sleep: not possible on this computer; use 'sudo tarven sleep shutdown' or 'server'"
        fi
        ;;
      *) echo "Use: sudo tarven sleep on | server | shutdown | off | status" >&2; exit 2 ;;
    esac
    ;;
  status)
    if systemctl is-active --quiet tarven-start.socket; then
      echo "Tarven Server is stopped to save power and starts when a device connects."
      exit 0
    fi
    systemctl --no-pager status tarven | head -n 5 || true
    echo
    "$server" server identity || true
    if [ -n "$(read_setup_code)" ]; then
      echo
      show_browser_setup
    fi
    ;;
  logs)
    exec journalctl -u tarven -f -n 50
    ;;
  start|stop|restart)
    require_root "$command"
    systemctl "$command" tarven
    ;;
  version)
    cat "$install_root/VERSION"
    ;;
  update)
    require_root update "$@"
    check_only=false assume_yes=false set_token=false from_app=false
    while [ $# -gt 0 ]; do
      case "$1" in
        --beta)
          case "${2:-}" in
            on) install -d -m 0755 "$(dirname "$channel_file")"; printf 'beta\n' > "$channel_file"
                echo "Beta updates are on: sudo tarven update also installs test versions." ;;
            off) rm -f "$channel_file"
                echo "Beta updates are off. An installed beta stays until a newer stable release arrives." ;;
            *) echo "Use: sudo tarven update --beta on|off" >&2; exit 2 ;;
          esac
          exit 0 ;;
        --check) check_only=true ;;
        --yes|-y) assume_yes=true ;;
        --set-token) set_token=true ;;
        # Run by tarven-update-request.service when the app left a request in the data folder.
        --from-app) from_app=true ;;
        *) echo "Unknown option: $1" >&2; exit 2 ;;
      esac
      shift
    done
    # Checks and updates tell the app what they found; setting the token does not.
    if ! $set_token && [ -d "$data_dir" ] && id tarven >/dev/null 2>&1; then report_update=true; fi
    # Consume app trigger files before checking the lock so systemd's path unit does not loop (audit LNX-PKG-009).
    from_app_kind=""
    if $from_app; then
      if [ -e "$data_dir/update-requested" ]; then
        from_app_kind=install
      elif [ -e "$data_dir/update-check-requested" ]; then
        from_app_kind=check
      else
        exit 0
      fi
      # The server's user may leave a folder there instead of a file; it must go too, or systemd
      # would start this again and again.
      rm -rf -- "$data_dir/update-requested" "$data_dir/update-check-requested"
    fi
    # Serialize checks, app-triggered installs and manual updates (audit LNX-PKG-009).
    if ! $set_token && command -v flock >/dev/null 2>&1; then
      exec 9>"${TARVEN_UPDATE_LOCK:-/run/tarven-update.lock}"
      if ! flock -n 9; then
        echo "A Tarven update is already running." >&2
        exit 0
      fi
    fi
    work=""
    cleanup_update() {
      local rc=$?
      end_update_bar
      [ -n "$work" ] && rm -rf "$work"
      if [ "$rc" -ne 0 ] && $report_update && ! $update_status_final; then
        write_update_status failed "The update stopped unexpectedly. See: journalctl -u tarven-update-request"
      fi
    }
    trap cleanup_update EXIT
    if [ "$from_app_kind" = install ]; then
      assume_yes=true
      status_progress=5 status_phase=checking
      write_update_status installing
    elif [ "$from_app_kind" = check ]; then
      check_only=true
      status_progress=5 status_phase=checking
      write_update_status checking
    fi
    if [ -z "$update_repository" ]; then
      echo "This installation does not know where its updates come from. Install a newer package by hand once." >&2
      write_update_status failed "This installation does not know where its updates come from."
      exit 1
    fi
    if ! command -v jq >/dev/null 2>&1; then
      command -v apt-get >/dev/null 2>&1 || { echo "Updating needs jq. Install it with your package manager first." >&2; write_update_status failed "Updating needs jq."; exit 1; }
      apt-get install -y jq >/dev/null
    fi
    if ! command -v openssl >/dev/null 2>&1; then
      command -v apt-get >/dev/null 2>&1 || { echo "Updating needs openssl. Install it with your package manager first." >&2; write_update_status failed "Updating needs openssl."; exit 1; }
      apt-get install -y openssl >/dev/null
    fi
    work=$(mktemp -d /var/tmp/tarven-update.XXXXXX)
    releases="$update_api/repos/$update_repository/releases"

    if $set_token; then
      echo "Create a fine-grained token on GitHub with read-only access to the contents of $update_repository."
      # A pasted token may come without a line end, which makes read report the end of input.
      read -r -s -p "GitHub token (hidden; leave empty to remove the saved one): " update_token || true
      echo
      if [ -z "$update_token" ]; then
        rm -f "$token_file"
        echo "The saved token was removed."
        exit 0
      fi
      [[ "$update_token" =~ ^[A-Za-z0-9_]+$ ]] || { echo "That is not a GitHub token." >&2; exit 2; }
      status=$(github_fetch "$releases?per_page=1" "$work/releases.json")
      [ "$status" = 200 ] || github_failed "$status" "the releases of $update_repository"
      install -d -m 0700 "$(dirname "$token_file")"
      (umask 077 && printf '%s\n' "$update_token" > "$token_file")
      echo "The token is saved. Check for updates with: sudo tarven update --check"
      exit 0
    fi

    [ -r "$token_file" ] && update_token=$(cat "$token_file")
    case "$(uname -m)" in
      x86_64|amd64) arch=x64 ;;
      aarch64|arm64) arch=arm64 ;;
      *) arch=$(uname -m) ;;
    esac
    # The latest release answers reliably and is the newest stable server (the Mac app ships
    # betas only). GitHub's list of releases often comes back empty although they exist, so it is
    # only asked when the latest release has no package for this computer, and an empty answer is
    # asked again a few times before it counts.
    newest=""
    beta_updates=false
    [ "$(cat "$channel_file" 2>/dev/null)" = beta ] && beta_updates=true
    # GitHub's latest release is never a pre-release, so the beta channel reads the list.
    if $beta_updates; then
      status=404
    else
      status=$(github_fetch "$releases/latest" "$work/latest.json")
    fi
    if [ "$status" = 200 ]; then
      jq '[.]' "$work/latest.json" > "$work/releases.json"
      newest=$(newest_package "$work/releases.json")
    elif [ "$status" != 404 ]; then
      github_failed "$status" "the releases of $update_repository"
    fi
    attempt=0
    while [ -z "$newest" ] && [ "$attempt" -lt 4 ]; do
      if [ "$attempt" -gt 0 ]; then sleep 2; fi
      attempt=$(( attempt + 1 ))
      # Newest first, 100 to a page; betas of every product sit between the stable servers, so
      # further pages are read until one holds a server (at most five).
      page=1
      while :; do
        status=$(github_fetch "$releases?per_page=100&page=$page" "$work/releases.json")
        [ "$status" = 200 ] || github_failed "$status" "the releases of $update_repository"
        newest=$(newest_package "$work/releases.json")
        [ -z "$newest" ] && [ "$(jq length "$work/releases.json")" -ge 100 ] && [ "$page" -lt 5 ] || break
        page=$(( page + 1 ))
      done
    done
    status_checked_at=$(date +%s)
    if [ -z "$newest" ]; then
      echo "No release of $update_repository has a Linux server package for $arch yet."
      write_update_status idle
      exit 0
    fi
    IFS=$'\t' read -r build version name url sums_url signature_url <<<"$newest"
    status_newest_version=$version status_newest_build=$build
    installed=$(cat "$install_root/VERSION" 2>/dev/null || echo unknown)
    installed_build=$(sed -n 's/.*(\([0-9][0-9]*\)).*/\1/p' <<<"$installed")
    echo "Installed: Tarven Server $installed"
    echo "Newest:    Tarven Server $version ($build)"
    if [ -z "$installed_build" ]; then
      unreadable="Cannot read the installed build from $install_root/VERSION; refusing to update without downgrade protection. Reinstall a signed package by hand."
      echo "$unreadable" >&2
      write_update_status failed "$unreadable"
      exit 1
    fi
    if [ "$build" -le "$installed_build" ]; then
      if [ "$build" -eq "$installed_build" ]; then
        echo "Tarven Server is up to date."
      else
        echo "The installed version is newer than the newest release; it is not downgraded."
      fi
      write_update_status idle
      exit 0
    fi
    if $check_only; then
      echo "Install it with: sudo tarven update"
      write_update_status idle
      exit 0
    fi
    if ! $assume_yes; then
      read -r -p "Install $version ($build) now? Accounts, library and settings stay. [y/N] " answer || true
      case "$answer" in
        y|Y|yes|YES) ;;
        *) echo "Nothing was changed."; exit 0 ;;
      esac
    fi

    status_target=$build
    package_size=$(jq -r --arg name "$name" '[.[].assets[]? | select(.name == $name) | (.size // 0)][0] // 0' "$work/releases.json" 2>/dev/null || echo 0)
    [[ "$package_size" =~ ^[0-9]+$ ]] || package_size=0
    status_progress=12 status_phase=verifying
    write_update_status installing
    if [ -t 2 ]; then
      show_update_bar 12 "Verifying release signature..."
    else
      echo "Downloading $name..."
    fi
    status=$(github_fetch "$sums_url" "$work/SHA256SUMS" application/octet-stream)
    [ "$status" = 200 ] || { end_update_bar; github_failed "$status" SHA256SUMS; }
    unsigned="The release is not signed by the owner of Tarven; nothing was installed."
    if [ -z "$signature_url" ]; then
      end_update_bar
      echo "$unsigned" >&2
      write_update_status failed "$unsigned"
      exit 1
    fi
    status=$(github_fetch "$signature_url" "$work/SHA256SUMS.minisig" application/octet-stream)
    [ "$status" = 200 ] || { end_update_bar; github_failed "$status" SHA256SUMS.minisig; }
    mkdir "$work/signature"
    if ! signature_valid "$work/SHA256SUMS" "$work/SHA256SUMS.minisig" "$work/signature"; then
      end_update_bar
      echo "$unsigned" >&2
      write_update_status failed "$unsigned"
      exit 1
    fi
    status_progress=15 status_phase=downloading
    write_update_status installing
    show_update_bar 15 "Downloading $name..."
    status=$(github_fetch_package "$url" "$work/$name" "$package_size" "$name")
    [ "$status" = 200 ] || { end_update_bar; github_failed "$status" "$name"; }
    status_progress=85 status_phase=unpacking
    write_update_status installing
    show_update_bar 85 "Checking SHA-256 and unpacking..."
    expected=$(awk -v name="$name" '{ file = $2; sub(/^\*/, "", file); sub(/^\.\//, "", file); if (file == name) print $1 }' \
      "$work/SHA256SUMS")
    actual=$(sha256sum "$work/$name" | awk '{ print $1 }')
    if [ -z "$expected" ] || [ "$expected" != "$actual" ]; then
      end_update_bar
      echo "The download does not match its checksum; nothing was installed." >&2
      write_update_status failed "The download does not match its checksum; nothing was installed."
      exit 1
    fi
    # Only the package's own folder is unpacked, and only into this temporary folder.
    folder="Tarven-Server-$version-linux-$arch"
    tar -tzf "$work/$name" > "$work/contents"
    if ! awk -v folder="$folder" 'index($0, folder "/") != 1 || /(^|\/)\.\.(\/|$)/ { bad = 1 } END { exit bad }' \
      "$work/contents"; then
      end_update_bar
      echo "The download is not a Tarven Server package; nothing was installed." >&2
      write_update_status failed "The download is not a Tarven Server package; nothing was installed."
      exit 1
    fi
    mkdir "$work/package"
    tar -xzf "$work/$name" --no-same-owner -C "$work/package"
    package="$work/package/$folder"
    if [ "$(cat "$package/VERSION" 2>/dev/null)" != "$version ($build)" ] \
      || [ "$(cat "$package/ARCHITECTURE" 2>/dev/null)" != "$arch" ]; then
      end_update_bar
      echo "The download is not Tarven Server $version ($build) for $arch; nothing was installed." >&2
      write_update_status failed "The download is not Tarven Server $version ($build) for $arch; nothing was installed."
      exit 1
    fi
    status_progress=92 status_phase=restarting
    write_update_status installing
    show_update_bar 92 "Installing and restarting Tarven Server..."
    end_update_bar
    # The installer stops Tarven, also when power saving stopped it, replaces only the program and
    # starts it again. It replaces this command too; bash read this whole case statement before
    # running it, so the lines after the installer still run as written here.
    status=0
    "$package/install.sh" || status=$?
    if [ "$status" -eq 0 ]; then
      if [ -t 2 ]; then
        show_update_bar 100 "Updated to Tarven Server $version ($build)"
        end_update_bar
      fi
      write_update_status idle
    else
      write_update_status failed "Installing $version ($build) failed; Tarven Server keeps its previous version where possible."
    fi
    exit "$status"
    ;;
  uninstall)
    require_root uninstall
    exec "$install_root/install.sh" --uninstall "$@"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
