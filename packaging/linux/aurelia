#!/bin/bash
# The aurelia command on a Linux server: sets it up over SSH, approves devices and passes
# library, pairing and server commands to the installed Aurelia Server.
set -euo pipefail

install_root=/opt/aurelia
server="$install_root/server/Aurelia.Server"
data_dir=/var/lib/aurelia

require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "Run this with sudo: sudo aurelia $*" >&2
    exit 1
  fi
}

wait_until_ready() {
  for _ in $(seq 1 60); do
    if "$server" server identity >/dev/null 2>&1; then return 0; fi
    sleep 1
  done
  echo "Aurelia Server did not start. See: aurelia logs" >&2
  return 1
}

# Power saving may have stopped Aurelia Server; connecting to its local port starts it again.
ensure_running() {
  systemctl is-active --quiet aurelia && return 0
  (exec 3<>/dev/tcp/127.0.0.1/43110) 2>/dev/null || true
  wait_until_ready
}

# Updates come from the GitHub Releases of the repository the package was built from. A private
# repository needs a read-only token, which only root may read.
token_file=/etc/aurelia/github-token
# "beta" here also offers GitHub pre-releases (test versions); set with: sudo aurelia update --beta on
channel_file=/etc/aurelia/update-channel
update_api=${AURELIA_UPDATE_API:-https://api.github.com}
update_repository=${AURELIA_UPDATE_REPOSITORY:-$(cat "$install_root/REPOSITORY" 2>/dev/null || true)}
update_token=""
# The owner's minisign key, the same that signs Aurelia for Linux (docs/LINUX_UPDATE_SIGNING.md).
# A release's SHA256SUMS must carry its signature, so a changed GitHub release installs nothing.
# Builds before first_signed_build were published without one. Tests with a stand-in for GitHub
# sign with their own key.
signing_public_key=RWT0nYptHNjXQSXnVurY9XXdPF2Ssq5sUlSP+WoBwjA5GPXWnugBc7lE
first_signed_build=153
[ -n "${AURELIA_UPDATE_API:-}" ] && signing_public_key=${AURELIA_UPDATE_SIGNING_KEY:-$signing_public_key}

# Succeeds when $2 is a minisign signature of $1 made with signing_public_key, checked with
# openssl so that no further program is needed. Only the prehashed form that minisign writes is
# accepted. $3 is an empty folder for the intermediate files.
signature_valid() {
  local file=$1 signature=$2 scratch=$3
  base64 -d <<<"$signing_public_key" > "$scratch/key.bin" 2>/dev/null || return 1
  sed -n 2p "$signature" | base64 -d > "$scratch/signature.bin" 2>/dev/null || return 1
  [ "$(wc -c < "$scratch/key.bin")" -eq 42 ] && [ "$(wc -c < "$scratch/signature.bin")" -eq 74 ] || return 1
  [ "$(head -c 2 "$scratch/key.bin")" = Ed ] && [ "$(head -c 2 "$scratch/signature.bin")" = ED ] || return 1
  [ "$(head -c 10 "$scratch/key.bin" | tail -c 8 | od -An -tx1)" \
    = "$(head -c 10 "$scratch/signature.bin" | tail -c 8 | od -An -tx1)" ] || return 1
  { printf '\060\052\060\005\006\003\053\145\160\003\041\000'; tail -c 32 "$scratch/key.bin"; } > "$scratch/key.der"
  tail -c 64 "$scratch/signature.bin" > "$scratch/signature.raw"
  openssl dgst -blake2b512 -binary "$file" > "$scratch/hash" 2>/dev/null || return 1
  openssl pkeyutl -verify -pubin -keyform DER -inkey "$scratch/key.der" -rawin -in "$scratch/hash" \
    -sigfile "$scratch/signature.raw" >/dev/null 2>&1
}

# Saves a GitHub address to a file and prints the HTTP status. The token reaches curl through its
# standard input, so it never shows up in the process list, and curl drops it when GitHub
# redirects a download to its file storage.
github_fetch() {
  local url=$1 output=$2 accept=${3:-application/vnd.github+json} protocols="=https"
  # Tests point the updater at a local stand-in for GitHub.
  [ -n "${AURELIA_UPDATE_API:-}" ] && protocols="=http,https"
  {
    [ -z "$update_token" ] || printf 'header = "Authorization: Bearer %s"\n' "$update_token"
  } | curl -sSL --proto "$protocols" --proto-redir "$protocols" --connect-timeout 15 --retry 2 \
    -H "Accept: $accept" -H "X-GitHub-Api-Version: 2022-11-28" -K - -o "$output" -w '%{http_code}' "$url" \
    || true
}

# Tells the app what `aurelia update` found or does. Aurelia Server reads update-status from its
# data folder, so the file belongs to the server's user; values stay plain and short.
report_update=false
status_newest_version="" status_newest_build="" status_target="" status_checked_at=""
write_update_status() {
  local state=$1 message=${2:-}
  $report_update || return 0
  message=$(printf '%s' "$message" | tr -cd '[:print:]' | cut -c1-200)
  # Written as the server's user: root changing owners in that user's folder could be led along
  # a link onto any file of the computer.
  printf 'STATE=%s\nCHANGED_AT=%s\nCHECKED_AT=%s\nNEWEST_VERSION=%s\nNEWEST_BUILD=%s\nTARGET_BUILD=%s\nMESSAGE=%s\n' \
    "$state" "$(date +%s)" "$status_checked_at" "$status_newest_version" "$status_newest_build" "$status_target" \
    "$message" \
    | runuser -u aurelia -- /bin/sh -c 'umask 077; t=$(mktemp "$1.XXXXXX") && cat > "$t" && mv -f "$t" "$1"' sh "$data_dir/update-status" \
    || true
}

github_failure() {
  case "$1" in
    401) echo "GitHub refused the token; it may have expired. Save a new one: sudo aurelia update --set-token" ;;
    403|429) echo "GitHub refused $2 for now (too many requests or no access). Try again later." ;;
    404)
      if [ -n "$update_token" ]; then
        echo "GitHub did not find $2. Check that the token may read $update_repository."
      else
        echo "GitHub did not find $2. A private repository needs a token: sudo aurelia update --set-token"
      fi ;;
    000|"") echo "GitHub could not be reached. Check the internet connection." ;;
    *) echo "GitHub answered $2 with status $1." ;;
  esac
}

github_failed() {
  local message
  message=$(github_failure "$@")
  echo "$message" >&2
  write_update_status failed "$message"
  exit 1
}

# The published release with the highest build that has a package for this computer ($arch) and
# a checksum list, as build, version, file name, file, checksum and signature addresses (the last
# empty without a signature); drafts are skipped, and pre-releases unless the beta channel is on.
# Prints nothing when there is none.
newest_package() {
  jq -r --arg arch "$arch" --argjson beta "${beta_updates:-false}" '
    [ .[] | select((.draft | not) and ($beta or (.prerelease | not)))
      | first(.assets[] | select(.name == "SHA256SUMS") | .url) as $sums
      | (first(.assets[] | select(.name == "SHA256SUMS.minisig") | .url) // "") as $signature
      | .assets[]
      | (.name | capture("^Aurelia-Server-(?<version>[0-9][0-9.]*)-(?<build>[0-9]+)-linux-" + $arch + "\\.tar\\.gz$")) as $found
      | [($found.build | tonumber), $found.version, .name, .url, $sums, $signature] ]
    | max_by(.[0]) // empty | .[0] |= tostring | join("\t")' "$1"
}

usage() {
  cat <<'USAGE'
Aurelia Server

  sudo aurelia setup [--name "Server Name"] [--power always|save|stop-only] [--browser | --terminal]
                                              --browser: set up in a web browser with a one-time code
                                              Create the owner, turn on network access, choose power use
  aurelia pair                                Show a code to type on a new device (Mac, Linux PC,
                                              Apple TV, iPhone, iPad or browser)
  aurelia approve [CODE]                      Allow an older app that shows a code itself
  aurelia library add --path PATH [--kind automatic|movies|tv] [--name NAME]
  aurelia library list | scan --all | remove --id ID --yes
  aurelia status                              Is the server running, and its fingerprint
  sudo aurelia sleep on [--idle MINUTES] [--awake 17:00-23:30|off]
                                              Computer sleeps when unused; Wake-on-LAN wakes it
  sudo aurelia sleep server [--idle MINUTES] [--awake ...]
  sudo aurelia sleep shutdown [--idle MINUTES] [--awake ...]
                                              Computer turns off when unused; Wake-on-LAN starts it
                                              (on and shutdown: --wake-on-access on|off also wakes it
                                              when a device such as a browser connects directly)
                                              Only Aurelia stops; a device starts it again
  sudo aurelia sleep off | status             Also in Aurelia's server settings on a Mac
  aurelia logs                                Follow the server log (Ctrl+C ends)
  sudo aurelia restart | start | stop
  aurelia version
  sudo aurelia update [--check] [--yes]       Install the newest version from GitHub
  sudo aurelia update --set-token             Save the GitHub token a private download needs
  sudo aurelia update --beta on|off           Also install test versions (pre-releases)
                                              Updates can also be installed in Aurelia on a Mac
  sudo aurelia uninstall [--remove-data]      Server data stays unless --remove-data

Commands that change the server ask for the owner's name, Server Password and PIN.
USAGE
}

# The addresses and the one-time code for setting this server up in a browser.
show_browser_setup() {
  local code="" tries=0
  while [ -z "$code" ] && [ $tries -lt 20 ]; do
    code=$(cat "$data_dir/browser-setup-code" 2>/dev/null || true)
    [ -n "$code" ] || { sleep 0.5; tries=$((tries + 1)); }
  done
  if [ -z "$code" ]; then
    echo "No setup code: this server already has an owner, or it isn't running. Run: sudo aurelia status" >&2
    return 1
  fi
  echo "Set up Aurelia in a web browser on any computer, phone or tablet at home:"
  for address in $(hostname -I 2>/dev/null); do
    case "$address" in *:*) continue ;; esac
    echo "  https://$address:43111"
  done
  echo
  echo "  Setup code: $code"
  echo
  echo "The browser warns about the certificate the first time; that is expected. The page shows"
  echo "the same verification fingerprint as 'aurelia status' if you want to compare."
  "$server" server identity 2>/dev/null | grep -i fingerprint || true
}

command=${1:-help}
[ $# -gt 0 ] && shift

case "$command" in
  setup)
    require_root setup
    name=""
    power=""
    way=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --name) name=${2:-}; shift 2 ;;
        --power) power=${2:-}; shift 2 ;;
        --browser) way=browser; shift ;;
        --terminal) way=terminal; shift ;;
        *) echo "Unknown option: $1" >&2; exit 2 ;;
      esac
    done
    if [ -z "$way" ]; then
      echo "How do you want to set up Aurelia?"
      echo "  1) In a web browser on any computer, phone or tablet at home (recommended)"
      echo "  2) Here in the terminal"
      read -r -p "Choose 1 or 2 [1]: " way || way=""
      case "${way:-1}" in 2|terminal) way=terminal ;; *) way=browser ;; esac
    fi
    if [ "$way" = browser ]; then
      systemctl stop aurelia-start.socket aurelia 2>/dev/null || true
      arguments=(setup-browser --data-dir "$data_dir")
      [ -n "$name" ] && arguments+=(--server-name "$name")
      if ! (cd "$data_dir" && runuser -u aurelia -- "$server" "${arguments[@]}"); then
        systemctl start aurelia
        exit 1
      fi
      systemctl start aurelia
      wait_until_ready
      show_browser_setup
      exit 0
    fi
    read -r -p "Owner name (used to sign in): " owner
    [ -n "$owner" ] || { echo "An owner name is required." >&2; exit 2; }
    systemctl stop aurelia-start.socket aurelia
    arguments=(setup-owner --headless --data-dir "$data_dir" --username "$owner" --device-name "$(hostname)")
    [ -n "$name" ] && arguments+=(--server-name "$name")
    # The aurelia user may not read the caller's folder, so the server starts in its own.
    if ! (cd "$data_dir" && runuser -u aurelia -- "$server" "${arguments[@]}"); then
      systemctl start aurelia
      exit 1
    fi
    # The owner exists now, so the browser setup code is no longer needed.
    rm -f "$data_dir/browser-setup-code"
    systemctl start aurelia
    wait_until_ready
    "$server" server identity
    # One question instead of the power settings: the answer sets them up.
    if [ -z "$power" ]; then
      echo
      echo "Should this computer stay on all the time?"
      echo "  1) Always on: Aurelia is ready at any moment. Uses the most power."
      echo "  2) Save power: the computer sleeps after 15 unused minutes. Aurelia on a Mac,"
      echo "     or a router such as a FRITZ!Box, wakes it again (Wake-on-LAN)."
      echo "  3) Stop only Aurelia: for a computer that also does other work, such as a NAS."
      echo "     Aurelia starts again within seconds when a device connects."
      read -r -p "Choose 1, 2 or 3 [1]: " power || power=""
    fi
    echo
    case "${power:-1}" in
      2|save) "$0" sleep on --idle 15 --awake off ;;
      3|stop-only) "$0" sleep server --idle 15 --awake off ;;
      1|always) "$0" sleep off ;;
      *) echo "Unknown choice; Aurelia stays always on." >&2; "$0" sleep off ;;
    esac
    echo "Change this any time in a browser (Settings › Power), in Aurelia on a Mac or with: sudo aurelia sleep"
    echo
    echo "Next, connect your devices. The first one also asks for the owner's new viewing PIN."
    echo "  Run here: aurelia pair, then type the code in Aurelia on the new device"
    echo "  (Mac, Linux PC, Apple TV, iPhone, iPad, or this server's address in a browser)."
    ;;
  approve)
    ensure_running
    if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
      code=$1
      shift
      exec "$server" pairing approve --code "$code" "$@"
    fi
    exec "$server" pairing approve "$@"
    ;;
  pair)
    ensure_running
    exec "$server" pairing create "$@"
    ;;
  library|pairing|metadata)
    ensure_running
    exec "$server" "$command" "$@"
    ;;
  sleep)
    action=${1:-status}
    [ $# -gt 0 ] && shift
    # The settings sit in the server's private data folder, which only root and the server read.
    require_root sleep "$action"
    settings="$data_dir/sleep-settings"
    . "$install_root/aurelia-sleep-settings"
    read_sleep_settings "$settings"
    case "$action" in
      on|server|shutdown)
        while [ $# -gt 0 ]; do
          case "$1" in
            --idle) IDLE_MINUTES=${2:-}; shift 2 ;;
            --wake-on-access)
              case "${2:-}" in on|off) WAKE_ON_ACCESS=$2 ;; *) echo "--wake-on-access needs on or off." >&2; exit 2 ;; esac
              shift 2 ;;
            --awake)
              if [ "${2:-}" = off ]; then AWAKE_FROM="" AWAKE_UNTIL=""; else AWAKE_FROM=${2%%-*} AWAKE_UNTIL=${2##*-}; fi
              shift 2 ;;
            *) echo "Unknown option: $1" >&2; exit 2 ;;
          esac
        done
        [[ "$IDLE_MINUTES" =~ ^[0-9]+$ ]] && (( IDLE_MINUTES >= 5 && IDLE_MINUTES <= 1440 )) \
          || { echo "--idle needs a number of minutes from 5 to 1440." >&2; exit 2; }
        if [ -n "$AWAKE_FROM$AWAKE_UNTIL" ]; then
          for time in "$AWAKE_FROM" "$AWAKE_UNTIL"; do
            [[ "$time" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || { echo "--awake needs HH:MM-HH:MM, for example 17:00-23:30, or off." >&2; exit 2; }
          done
          [ "$AWAKE_FROM" != "$AWAKE_UNTIL" ] || { echo "--awake needs a different start and end." >&2; exit 2; }
        fi
        case "$action" in server) MODE=stop ;; shutdown) MODE=shutdown ;; *) MODE=sleep ;; esac
        write_sleep_settings "$settings"
        systemctl enable --now aurelia-autosleep.timer >/dev/null
        if [ "$MODE" = stop ]; then
          echo "Power saving is on. Aurelia Server stops five minutes after a player's sleep timer ends, and"
          if [ -n "$AWAKE_FROM" ]; then
            echo "after $IDLE_MINUTES unused minutes outside $AWAKE_FROM-$AWAKE_UNTIL. The computer stays on, and Aurelia"
          else
            echo "after $IDLE_MINUTES unused minutes. The computer stays on, and Aurelia"
          fi
          echo "starts again within seconds when a Mac or Apple TV connects."
          exit 0
        fi
        if ! command -v ethtool >/dev/null 2>&1 && command -v apt-get >/dev/null 2>&1; then
          apt-get install -y ethtool >/dev/null
        fi
        systemctl enable --now aurelia-wake-on-lan.service >/dev/null 2>&1 || echo "Wake-on-LAN could not be turned on; see: journalctl -u aurelia-wake-on-lan" >&2
        if [ "$MODE" = shutdown ]; then
          echo "Shut-down mode is on. The computer turns off five minutes after a player's sleep timer ends, and after"
        else
          echo "Sleep mode is on. The server sleeps five minutes after a player's sleep timer ends, and after"
        fi
        if [ -n "$AWAKE_FROM" ]; then
          echo "$IDLE_MINUTES unused minutes outside $AWAKE_FROM-$AWAKE_UNTIL. It wakes itself at $AWAKE_FROM; Aurelia on a"
        else
          echo "$IDLE_MINUTES unused minutes, at any time of day. Aurelia on a"
        fi
        echo "Mac wakes it when you open it, and a router such as a Fritzbox can wake it too (Wake-on-LAN)."
        if [ "$WAKE_ON_ACCESS" = on ]; then
          echo "It also wakes when a device that reached it shortly before connects directly, such as a browser."
        fi
        if [ "$MODE" = shutdown ]; then
          echo "Starting takes about a minute, and the BIOS must allow Wake-on-LAN while the computer is off."
        else
          echo "Some computers also need Wake-on-LAN allowed in the BIOS."
        fi
        ;;
      off)
        MODE=off
        write_sleep_settings "$settings"
        rm -f "$data_dir/sleep-ready"
        if ! systemctl is-active --quiet aurelia; then systemctl start aurelia; fi
        echo "Power saving is off; the server keeps running. Wake-on-LAN stays allowed."
        ;;
      status)
        if [ "$MODE" != off ]; then
          hours=""
          [ -n "$AWAKE_FROM" ] && hours=" outside $AWAKE_FROM-$AWAKE_UNTIL"
          what="the computer sleeps"
          [ "$MODE" = stop ] && what="only Aurelia stops"
          [ "$MODE" = shutdown ] && what="the computer turns off"
          echo "Power saving: $what (5 minutes after a sleep timer; after $IDLE_MINUTES unused minutes$hours)"
          [ "$MODE" != stop ] && [ "$WAKE_ON_ACCESS" = on ] && echo "Wakes when a device connects directly: on"
          scratch=$(mktemp -d)
          [ -r /run/aurelia-autosleep/last-active ] && cp /run/aurelia-autosleep/last-active "$scratch/"
          echo "Right now: $(AURELIA_AUTOSLEEP_DRY_RUN=1 AURELIA_AUTOSLEEP_STATE="$scratch" "$install_root/aurelia-autosleep" 2>/dev/null || echo "unknown")"
          rm -rf "$scratch"
        else
          echo "Power saving: off"
        fi
        device=$(ip -4 route show default | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
        [ -n "$device" ] && echo "Wake address: $(cat "/sys/class/net/$device/address") ($device)"
        ;;
      *) echo "Use: sudo aurelia sleep on | server | shutdown | off | status" >&2; exit 2 ;;
    esac
    ;;
  status)
    if systemctl is-active --quiet aurelia-start.socket; then
      echo "Aurelia Server is stopped to save power and starts when a device connects."
      exit 0
    fi
    systemctl --no-pager status aurelia | head -n 5 || true
    echo
    "$server" server identity || true
    if [ -r "$data_dir/browser-setup-code" ]; then
      echo
      show_browser_setup
    fi
    ;;
  logs)
    exec journalctl -u aurelia -f -n 50
    ;;
  start|stop|restart)
    require_root "$command"
    systemctl "$command" aurelia
    ;;
  version)
    cat "$install_root/VERSION"
    ;;
  update)
    require_root update "$@"
    check_only=false assume_yes=false set_token=false from_app=false
    while [ $# -gt 0 ]; do
      case "$1" in
        --beta)
          case "${2:-}" in
            on) install -d -m 0755 "$(dirname "$channel_file")"; printf 'beta\n' > "$channel_file"
                echo "Beta updates are on: sudo aurelia update also installs test versions." ;;
            off) rm -f "$channel_file"
                echo "Beta updates are off. An installed beta stays until a newer stable release arrives." ;;
            *) echo "Use: sudo aurelia update --beta on|off" >&2; exit 2 ;;
          esac
          exit 0 ;;
        --check) check_only=true ;;
        --yes|-y) assume_yes=true ;;
        --set-token) set_token=true ;;
        # Run by aurelia-update-request.service when the app left a request in the data folder.
        --from-app) from_app=true ;;
        *) echo "Unknown option: $1" >&2; exit 2 ;;
      esac
      shift
    done
    # Checks and updates tell the app what they found; setting the token does not.
    if ! $set_token && [ -d "$data_dir" ] && id aurelia >/dev/null 2>&1; then report_update=true; fi
    if $from_app; then
      if [ -e "$data_dir/update-requested" ]; then
        assume_yes=true
        write_update_status installing
      elif [ -e "$data_dir/update-check-requested" ]; then
        check_only=true
        write_update_status checking
      else
        exit 0
      fi
      # The server's user may leave a folder there instead of a file; it must go too, or systemd
      # would start this again and again.
      rm -rf -- "$data_dir/update-requested" "$data_dir/update-check-requested"
    fi
    if [ -z "$update_repository" ]; then
      echo "This installation does not know where its updates come from. Install a newer package by hand once." >&2
      write_update_status failed "This installation does not know where its updates come from."
      exit 1
    fi
    if ! command -v jq >/dev/null 2>&1; then
      command -v apt-get >/dev/null 2>&1 || { echo "Updating needs jq. Install it with your package manager first." >&2; exit 1; }
      apt-get install -y jq >/dev/null
    fi
    if ! command -v openssl >/dev/null 2>&1; then
      command -v apt-get >/dev/null 2>&1 || { echo "Updating needs openssl. Install it with your package manager first." >&2; exit 1; }
      apt-get install -y openssl >/dev/null
    fi
    work=$(mktemp -d /var/tmp/aurelia-update.XXXXXX)
    trap 'rm -rf "$work"' EXIT
    releases="$update_api/repos/$update_repository/releases"

    if $set_token; then
      echo "Create a fine-grained token on GitHub with read-only access to the contents of $update_repository."
      # A pasted token may come without a line end, which makes read report the end of input.
      read -r -s -p "GitHub token (hidden; leave empty to remove the saved one): " update_token || true
      echo
      if [ -z "$update_token" ]; then
        rm -f "$token_file"
        echo "The saved token was removed."
        exit 0
      fi
      [[ "$update_token" =~ ^[A-Za-z0-9_]+$ ]] || { echo "That is not a GitHub token." >&2; exit 2; }
      status=$(github_fetch "$releases?per_page=1" "$work/releases.json")
      [ "$status" = 200 ] || github_failed "$status" "the releases of $update_repository"
      install -d -m 0700 "$(dirname "$token_file")"
      (umask 077 && printf '%s\n' "$update_token" > "$token_file")
      echo "The token is saved. Check for updates with: sudo aurelia update --check"
      exit 0
    fi

    [ -r "$token_file" ] && update_token=$(cat "$token_file")
    case "$(uname -m)" in
      x86_64|amd64) arch=x64 ;;
      aarch64|arm64) arch=arm64 ;;
      *) arch=$(uname -m) ;;
    esac
    # The latest release answers reliably. GitHub's list of releases often comes back empty
    # although they exist, so it is only asked when the latest release has no package for this
    # computer, and an empty answer is asked again a few times before it counts.
    newest=""
    beta_updates=false
    [ "$(cat "$channel_file" 2>/dev/null)" = beta ] && beta_updates=true
    # GitHub's latest release is never a pre-release, so the beta channel reads the list.
    if $beta_updates; then
      status=404
    else
      status=$(github_fetch "$releases/latest" "$work/latest.json")
    fi
    if [ "$status" = 200 ]; then
      jq '[.]' "$work/latest.json" > "$work/releases.json"
      newest=$(newest_package "$work/releases.json")
    elif [ "$status" != 404 ]; then
      github_failed "$status" "the releases of $update_repository"
    fi
    attempt=0
    while [ -z "$newest" ] && [ "$attempt" -lt 4 ]; do
      if [ "$attempt" -gt 0 ]; then sleep 2; fi
      attempt=$(( attempt + 1 ))
      status=$(github_fetch "$releases?per_page=30" "$work/releases.json")
      [ "$status" = 200 ] || github_failed "$status" "the releases of $update_repository"
      newest=$(newest_package "$work/releases.json")
    done
    status_checked_at=$(date +%s)
    if [ -z "$newest" ]; then
      echo "No release of $update_repository has a Linux server package for $arch yet."
      write_update_status idle
      exit 0
    fi
    IFS=$'\t' read -r build version name url sums_url signature_url <<<"$newest"
    status_newest_version=$version status_newest_build=$build
    installed=$(cat "$install_root/VERSION" 2>/dev/null || echo unknown)
    installed_build=$(sed -n 's/.*(\([0-9][0-9]*\)).*/\1/p' <<<"$installed")
    echo "Installed: Aurelia Server $installed"
    echo "Newest:    Aurelia Server $version ($build)"
    if [ -n "$installed_build" ] && [ "$build" -le "$installed_build" ]; then
      if [ "$build" -eq "$installed_build" ]; then
        echo "Aurelia Server is up to date."
      else
        echo "The installed version is newer than the newest release; it is not downgraded."
      fi
      write_update_status idle
      exit 0
    fi
    if $check_only; then
      echo "Install it with: sudo aurelia update"
      write_update_status idle
      exit 0
    fi
    if ! $assume_yes; then
      read -r -p "Install $version ($build) now? Accounts, library and settings stay. [y/N] " answer || true
      case "$answer" in
        y|Y|yes|YES) ;;
        *) echo "Nothing was changed."; exit 0 ;;
      esac
    fi

    status_target=$build
    write_update_status installing
    echo "Downloading $name..."
    status=$(github_fetch "$sums_url" "$work/SHA256SUMS" application/octet-stream)
    [ "$status" = 200 ] || github_failed "$status" SHA256SUMS
    if [ "$build" -ge "$first_signed_build" ]; then
      unsigned="The release is not signed by the owner of Aurelia; nothing was installed."
      if [ -z "$signature_url" ]; then
        echo "$unsigned" >&2
        write_update_status failed "$unsigned"
        exit 1
      fi
      status=$(github_fetch "$signature_url" "$work/SHA256SUMS.minisig" application/octet-stream)
      [ "$status" = 200 ] || github_failed "$status" SHA256SUMS.minisig
      mkdir "$work/signature"
      if ! signature_valid "$work/SHA256SUMS" "$work/SHA256SUMS.minisig" "$work/signature"; then
        echo "$unsigned" >&2
        write_update_status failed "$unsigned"
        exit 1
      fi
    fi
    status=$(github_fetch "$url" "$work/$name" application/octet-stream)
    [ "$status" = 200 ] || github_failed "$status" "$name"
    expected=$(awk -v name="$name" '{ file = $2; sub(/^\*/, "", file); sub(/^\.\//, "", file); if (file == name) print $1 }' \
      "$work/SHA256SUMS")
    actual=$(sha256sum "$work/$name" | awk '{ print $1 }')
    if [ -z "$expected" ] || [ "$expected" != "$actual" ]; then
      echo "The download does not match its checksum; nothing was installed." >&2
      write_update_status failed "The download does not match its checksum; nothing was installed."
      exit 1
    fi
    # Only the package's own folder is unpacked, and only into this temporary folder.
    folder="Aurelia-Server-$version-linux-$arch"
    tar -tzf "$work/$name" > "$work/contents"
    if ! awk -v folder="$folder" 'index($0, folder "/") != 1 || /(^|\/)\.\.(\/|$)/ { bad = 1 } END { exit bad }' \
      "$work/contents"; then
      echo "The download is not an Aurelia Server package; nothing was installed." >&2
      write_update_status failed "The download is not an Aurelia Server package; nothing was installed."
      exit 1
    fi
    mkdir "$work/package"
    tar -xzf "$work/$name" --no-same-owner -C "$work/package"
    package="$work/package/$folder"
    if [ "$(cat "$package/VERSION" 2>/dev/null)" != "$version ($build)" ] \
      || [ "$(cat "$package/ARCHITECTURE" 2>/dev/null)" != "$arch" ]; then
      echo "The download is not Aurelia Server $version ($build) for $arch; nothing was installed." >&2
      write_update_status failed "The download is not Aurelia Server $version ($build) for $arch; nothing was installed."
      exit 1
    fi
    # The installer stops Aurelia, also when power saving stopped it, replaces only the program and
    # starts it again. It replaces this command too; bash read this whole case statement before
    # running it, so the lines after the installer still run as written here.
    status=0
    "$package/install.sh" || status=$?
    if [ "$status" -eq 0 ]; then
      write_update_status idle
    else
      write_update_status failed "Installing $version ($build) failed; Aurelia Server keeps its previous version where possible."
    fi
    exit "$status"
    ;;
  uninstall)
    require_root uninstall
    exec "$install_root/install.sh" --uninstall "$@"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "Unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
