[Unit]
Description=Aurelia media server
After=network-online.target local-fs.target
Wants=network-online.target
# While Aurelia is stopped to save power, this socket waits for devices in its place.
Conflicts=aurelia-start.socket

[Service]
Type=simple
User=aurelia
Group=aurelia
ExecStart=/opt/aurelia/server/Aurelia.Server run --data-dir /var/lib/aurelia
WorkingDirectory=/var/lib/aurelia
Environment=HOME=/var/lib/aurelia
# Root-run parts of the package act on what the app changes: power saving, updates.
Environment=AURELIA_LINUX_PACKAGE=1
StateDirectory=aurelia
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
# Restart Server in the app ends the server with this status for systemd to start it again.
RestartForceExitStatus=75
SuccessExitStatus=75
TimeoutStopSec=30
LimitNOFILE=65536
# Aurelia only reads media: everything outside its own data folder is read-only for it.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
