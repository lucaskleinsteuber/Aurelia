#!/bin/bash
# Saves power when nobody uses this Aurelia server. Depending on MODE it either stops only Aurelia
# Server ("stop"; systemd starts it again as soon as a device connects, through
# aurelia-start.socket) or puts the whole computer to sleep ("sleep", suspend to RAM; Wake-on-LAN
# wakes it, which Aurelia on a Mac sends). Either happens:
# - five minutes after a player's sleep timer ended, if nothing played since (Aurelia Server
#   leaves its sleep-ready file then), at any time of day;
# - otherwise after IDLE_MINUTES without a connected device, outside AWAKE_FROM-AWAKE_UNTIL when
#   those hours are set. With awake hours a sleeping computer also wakes itself at AWAKE_FROM.
#   An app left open with nobody using it does not count as a connected device.
# Settings: sleep-settings in the server's data folder, changed in the app's server settings or
# with `sudo aurelia sleep`. Run every five minutes by aurelia-autosleep.timer; it does nothing
# while MODE is off. `sudo aurelia sleep status` shows the current decision.
# With AURELIA_AUTOSLEEP_DRY_RUN=1 it only prints its decision.
set -euo pipefail
data=${AURELIA_DATA_DIR:-/var/lib/aurelia}
. "${AURELIA_SLEEP_SETTINGS_LIBRARY:-/opt/aurelia/aurelia-sleep-settings}"
read_sleep_settings "$data/sleep-settings"
dry_run=${AURELIA_AUTOSLEEP_DRY_RUN:-0}
state=${AURELIA_AUTOSLEEP_STATE:-/run/aurelia-autosleep}
ready=$data/sleep-ready

mkdir -p "$state"
now=$(date +%s)
[ -f "$state/last-active" ] || echo "$now" > "$state/last-active"

say() { if [ "$dry_run" = 1 ]; then echo "$1"; fi; }

# Aurelia stopped earlier and is waiting for a device. If stopping is no longer wanted, it starts
# again (starting it closes the waiting socket).
if ! systemctl is-active --quiet aurelia && systemctl is-active --quiet aurelia-start.socket; then
  if [ "$MODE" = stop ]; then say "stopped: Aurelia starts when a device connects"; exit 0; fi
  [ "$dry_run" = 1 ] || systemctl start aurelia
fi

# While nothing is to be saved, no time counts as unused, so turning it on starts a fresh period.
if [ "$MODE" = off ]; then
  echo "$now" > "$state/last-active"
  [ "$dry_run" = 1 ] || rm -f "$ready"
  say "running: power saving is off"
  exit 0
fi

minutes() { echo $(( 10#${1%%:*} * 60 + 10#${1##*:} )); }

# AWAKE_FROM on day $1 (today or tomorrow) in seconds. On the night the clocks go forward its
# time may not exist (02:30 in Europe); it then counts in the day's earlier offset, which is the
# same moment the clock shows an hour later. Prints nothing when even that fails.
wake_time() {
  date -d "$1 $AWAKE_FROM" +%s 2>/dev/null \
    || date -d "$1 $AWAKE_FROM $(date -d "$1 00:00" +%z 2>/dev/null)" +%s 2>/dev/null \
    || true
}

save_power() {
  if [ "$MODE" = stop ]; then
    if [ "$dry_run" = 1 ]; then echo "stop Aurelia until a device connects: $1"; exit 0; fi
    rm -f "$ready"
    logger -t aurelia-autosleep "$1: stopping Aurelia Server until a device connects."
    echo "$now" > "$state/last-active"
    # The socket conflicts with the service: starting it stops Aurelia and listens in its place.
    # If it cannot listen, Aurelia must not stay unreachable.
    if ! systemctl start aurelia-start.socket; then
      logger -t aurelia-autosleep "Could not wait for devices; Aurelia Server keeps running."
      systemctl start aurelia
    fi
    exit 0
  fi
  local wake="" until="a Wake-on-LAN call"
  if [ -n "$AWAKE_FROM" ]; then
    wake=$(wake_time today)
    if [ -z "$wake" ] || (( wake <= now )); then wake=$(wake_time tomorrow); fi
    [ -z "$wake" ] || until="$(date -d "@$wake" '+%a %H:%M') or a Wake-on-LAN call"
  fi
  if [ "$dry_run" = 1 ]; then echo "sleep until $until: $1"; exit 0; fi
  rm -f "$ready"
  logger -t aurelia-autosleep "$1: sleeping until $until."
  # After waking, devices get a fresh idle period to connect.
  echo "$now" > "$state/last-active"
  if [ -n "$wake" ]; then
    rtcwake -m mem -t "$wake" >/dev/null
  else
    # A wake time left from earlier awake hours must not wake it now.
    rtcwake -m disable >/dev/null 2>&1 || true
    echo mem > /sys/power/state
  fi
  date +%s > "$state/last-active"
  exit 0
}

# Someone signed in over SSH is working on the computer: never put it to sleep under them.
if [ "$MODE" = sleep ] && ss -Htn state established '( sport = :22 )' | grep -q .; then
  echo "$now" > "$state/last-active"
  say "awake: signed in over SSH"
  exit 0
fi

# An update is being checked or installed: sleeping now could leave a half-replaced program.
# This also holds after an ended sleep timer; the timer's signal stays for the next check.
if systemctl is-active --quiet aurelia-update-request.service aurelia-update-check.service; then
  echo "$now" > "$state/last-active"
  say "awake: updating"
  exit 0
fi

# A sleep timer ended five minutes ago and nothing played since. A signal older than a quarter of
# an hour is stale (power saving was off then) and is ignored.
if [ -f "$ready" ]; then
  if (( now - $(stat -c %Y "$ready") < 900 )); then save_power "A sleep timer ended"; fi
  [ "$dry_run" = 1 ] || rm -f "$ready"
fi

# In use: someone used Aurelia on a device, or the computer is working (a scan, an update).
# Aurelia Server notes in last-use when someone last browsed, played or saved progress; an app
# that is merely open keeps its sync and Play On connections without counting. A server without
# that file (an older one still running) counts every connected device instead.
busy=false
used=""
[ -f "$data/last-use" ] && used=$(head -c 20 "$data/last-use" 2>/dev/null || true)
if [[ "$used" =~ ^[0-9]+$ ]]; then
  (( used > now )) && used=$now
  (( used > $(cat "$state/last-active") )) && echo "$used" > "$state/last-active"
elif ss -Htn state established '( sport = :43111 )' | grep -q .; then
  busy=true
fi
if awk '{ exit !($1 > 0.5) }' /proc/loadavg; then busy=true; fi
if systemctl is-active --quiet aurelia-update-request.service aurelia-update-check.service; then busy=true; fi
if $busy; then
  echo "$now" > "$state/last-active"
  say "awake: in use"
  exit 0
fi

if [ -n "$AWAKE_FROM" ] && [ -n "$AWAKE_UNTIL" ]; then
  current=$(minutes "$(date +%H:%M)")
  from=$(minutes "$AWAKE_FROM")
  until=$(minutes "$AWAKE_UNTIL")
  in_window=false
  if (( from < until )); then
    (( current >= from && current < until )) && in_window=true
  else
    (( current >= from || current < until )) && in_window=true
  fi
  if $in_window; then say "awake: $AWAKE_FROM-$AWAKE_UNTIL"; exit 0; fi
fi

last=$(cat "$state/last-active")
if (( now - last < IDLE_MINUTES * 60 )); then
  say "awake: used $(( (now - last) / 60 )) minutes ago"
  exit 0
fi
save_power "Unused for $IDLE_MINUTES minutes"
