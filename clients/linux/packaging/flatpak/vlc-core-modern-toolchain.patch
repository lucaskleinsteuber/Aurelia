--- a/src/misc/interrupt.c
+++ b/src/misc/interrupt.c
@@ -291,7 +291,15 @@
     int canc;
 
     canc = vlc_savecancel();
-    write(fd[1], &value, sizeof (value));
+    ssize_t written;
+    do
+        written = write(fd[1], &value, sizeof (value));
+    while (written < 0 && errno == EINTR);
+    /* A full nonblocking pipe already holds a wakeup. All other failures mean
+     * the interruption channel itself is broken: do not silently lose a wake. */
+    if (written != (ssize_t)sizeof (value)
+     && !(written < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)))
+        abort();
     vlc_restorecancel(canc);
 }
 
@@ -350,8 +358,19 @@
     {
         uint64_t dummy;
 
-        read(fd[0], &dummy, sizeof (dummy));
-        ret--;
+        ssize_t drained;
+        do
+            drained = read(fd[0], &dummy, sizeof (dummy));
+        while (drained < 0 && errno == EINTR);
+        if (drained == (ssize_t)sizeof (dummy)
+         || (drained < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)))
+            ret--;
+        else
+        {
+            if (drained >= 0)
+                errno = EIO;
+            ret = -1;
+        }
     }
     vlc_cleanup_pop();
 
