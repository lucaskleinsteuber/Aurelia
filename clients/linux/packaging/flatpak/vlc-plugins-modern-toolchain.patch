+static bool UpdateOutputFormat(filter_t *filter)
+{
+    const video_format_t *input = &filter->fmt_in.video;
+    video_format_t *output = &filter->fmt_out.video;
+    if (input->i_width == 0 || input->i_height == 0 ||
+        output->i_width == 0 || output->i_height == 0)
+        return false;
+    if (filter->b_allow_fmt_out_change)
+    {
+        /* Derive from the input each time; never compound the previous frame's SAR. */
+        output->i_sar_num = input->i_sar_num != 0 ? input->i_sar_num : 1;
+        output->i_sar_den = input->i_sar_den != 0 ? input->i_sar_den : 1;
+        video_format_ScaleCropAr(output, input);
+    }
+    return true;
+}
