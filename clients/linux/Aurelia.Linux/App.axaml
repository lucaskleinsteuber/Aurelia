<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aurelia.Linux.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://aurelia-desktop/Design/AureliaTokens.axaml" />
        <ResourceInclude Source="avares://aurelia-desktop/Design/AureliaIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://aurelia-desktop/Design/AureliaStyles.axaml" />
  </Application.Styles>
</Application>
