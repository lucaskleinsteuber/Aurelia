<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Aurelia.Linux.Views"
        x:Class="Aurelia.Linux.Views.MainWindow"
        Title="Aurelia"
        Width="1280" Height="800"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AureliaCanvasBrush}">
  <!-- The window keeps the desktop's own title bar and buttons (KDE, GNOME, …). -->
  <views:LibraryShell x:Name="Shell" />
</Window>
