<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Aurelia.Linux.Controls"
        x:Class="Aurelia.Linux.Views.MainWindow"
        Title="Aurelia"
        Width="1280" Height="800"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AureliaCanvasBrush}">
  <!-- No title bar: the content reaches the top edge and Aurelia draws its own window buttons. -->
  <Panel>
    <ContentControl x:Name="ScreenHost" />
    <!-- The player covers the library while it plays, as on the Mac. -->
    <ContentControl x:Name="PlayerHost" IsVisible="False" />
    <controls:WindowChrome x:Name="Chrome" />
  </Panel>
</Window>
