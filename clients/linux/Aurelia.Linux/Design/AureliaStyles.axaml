<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Menus, dropdowns and tooltips open in their own popup windows; they use Aurelia's font too. -->
  <Style Selector="PopupRoot, OverlayPopupHost">
    <Setter Property="FontFamily" Value="{StaticResource AureliaFontFamily}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter, ContextMenu">
    <Setter Property="Padding" Value="5" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinWidth" Value="200" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="13.5" />
  </Style>
  <Style Selector="MenuFlyoutPresenter Separator, ContextMenu Separator">
    <Setter Property="Margin" Value="8,4" />
    <Setter Property="Background" Value="#1FFFFFFF" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,6,8,6" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="4,1" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource AureliaFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource AureliaBodyFontSize}" />
    <Setter Property="Foreground" Value="{StaticResource AureliaPrimaryTextBrush}" />
  </Style>

  <!-- Typography -->
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="{StaticResource AureliaPageTitleFontSize}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.heroTitle">
    <Setter Property="FontSize" Value="{StaticResource AureliaHeroTitleFontSize}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="{StaticResource AureliaSectionTitleFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.4" />
  </Style>
  <Style Selector="TextBlock.subdued">
    <Setter Property="Foreground" Value="{StaticResource AureliaSubduedTextBrush}" />
  </Style>

  <!-- Sidebar rows: tinted symbols, as in the Apple TV app's sidebar; on the selection they turn
       white so they stay visible on the highlight. -->
  <Style Selector="ListBox.sidebar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem">
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource AureliaPrimaryTextBrush}" />
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem PathIcon">
    <Setter Property="Foreground" Value="{StaticResource AureliaAccentBrush}" />
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AureliaHoverBrush}" />
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AureliaSelectionBrush}" />
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AureliaSelectionBrush}" />
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem:selected TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem:selected PathIcon">
    <Setter Property="Foreground" Value="{StaticResource AureliaPrimaryTextBrush}" />
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AureliaAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- A round, translucent button over content, like the Mac app's sidebar toggle. -->
  <Style Selector="Button.chrome">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="Background" Value="#66282C2F" />
    <Setter Property="Foreground" Value="{StaticResource AureliaPrimaryTextBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.chrome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#99383C40" />
    <Setter Property="Foreground" Value="{StaticResource AureliaPrimaryTextBrush}" />
  </Style>

  <!-- The white capsule for a page's main action ("Open", "Play"). -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#F5F5F7" />
    <Setter Property="Foreground" Value="#111316" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="22,0" />
    <Setter Property="MinHeight" Value="{StaticResource AureliaMinimumControlSize}" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#111316" />
  </Style>

  <!-- Cards on shelves. -->
  <Style Selector="Border.card">
    <Setter Property="CornerRadius" Value="{StaticResource AureliaCardRadius}" />
    <Setter Property="Background" Value="{StaticResource AureliaSurfaceBrush}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- Window buttons: small neutral circles that stay visible over artwork. -->
  <Style Selector="Button.windowButton">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Background" Value="#3D2A2E33" />
    <Setter Property="Foreground" Value="#E6F5F5F7" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.windowButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#66474C53" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
  </Style>
  <Style Selector="Button.windowButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#80565C64" />
  </Style>

  <!-- A choice card, as on the Mac's welcome screen. -->
  <Style Selector="Button.choice">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="MinHeight" Value="82" />
    <Setter Property="CornerRadius" Value="{StaticResource AureliaCardRadius}" />
    <Setter Property="Background" Value="{StaticResource AureliaSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AureliaHairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.choice.recommended">
    <Setter Property="Background" Value="{StaticResource AureliaRaisedSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="#2EFFFFFF" />
  </Style>
  <Style Selector="Button.choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#33373C" />
    <Setter Property="BorderBrush" Value="#3DFFFFFF" />
  </Style>
  <Style Selector="Button.choice.recommended:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#454A4F" />
  </Style>
  <Style Selector="Button.choice:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AureliaAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.choiceSymbol">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{StaticResource AureliaRaisedSurfaceBrush}" />
  </Style>
  <Style Selector="Button.choice.recommended Border.choiceSymbol">
    <Setter Property="Background" Value="#F0FFFFFF" />
  </Style>
  <Style Selector="Button.choice.recommended Border.choiceSymbol PathIcon">
    <Setter Property="Foreground" Value="#111316" />
  </Style>

  <!-- A quiet text button, for links like "Back". -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource AureliaAccentBrush}" />
    <Setter Property="Padding" Value="6,4" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#4DA3FF" />
  </Style>

  <!-- A profile in "Who's watching?". -->
  <Style Selector="Button.profile">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="CornerRadius" Value="{StaticResource AureliaCardRadius}" />
    <Setter Property="Width" Value="150" />
  </Style>
  <Style Selector="Button.profile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AureliaHoverBrush}" />
  </Style>
  <Style Selector="Button.profile:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.profile:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- The PIN as on the Mac's login window: a rounded glass field with an arrow that turns white. -->
  <Style Selector="Border.pinCapsule">
    <Setter Property="CornerRadius" Value="26" />
    <Setter Property="Background" Value="#59101214" />
    <Setter Property="BorderBrush" Value="#29FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.pinCapsule.focused">
    <Setter Property="BorderBrush" Value="{StaticResource AureliaAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBox.pinField">
    <Style.Resources>
      <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
    </Style.Resources>
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBox.pinField:pointerover /template/ Border#PART_BorderElement, TextBox.pinField:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.pinArrow">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#000000" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.pinArrow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#E6FFFFFF" />
    <Setter Property="Foreground" Value="#000000" />
  </Style>
  <Style Selector="Button.pinArrow:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1FFFFFFF" />
    <Setter Property="Foreground" Value="#80FFFFFF" />
  </Style>
  <Style Selector="Button.profileAvatar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="48" />
  </Style>
  <Style Selector="Button.profileAvatar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <!-- The season's name as a menu, like the Mac's borderless season menu. -->
  <Style Selector="Button.seasonMenu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.seasonMenu:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AureliaHoverBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.seasonMenu:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AureliaSelectionBrush}" />
  </Style>

  <!-- A card inside a card (one person in the metadata editor), and small symbol buttons on it. -->
  <Style Selector="Border.nestedCard">
    <Setter Property="Background" Value="#0DFFFFFF" />
    <Setter Property="BorderBrush" Value="#14FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Button.iconSmall">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#CCFFFFFF" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.iconSmall:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AureliaHoverBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.iconSmall:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#40FFFFFF" />
  </Style>

  <Style Selector="Button.sidebarFooter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Button.sidebarFooter:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AureliaHoverBrush}" />
  </Style>

  <!-- Text fields on the Aurelia surface, also while focused. -->
  <Style Selector="TextBox">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource AureliaSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="#33FFFFFF" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="40" />
  </Style>
  <!-- Text that spans several lines starts at the top. -->
  <Style Selector="TextBox[AcceptsReturn=True]">
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#2E3236" />
    <Setter Property="BorderBrush" Value="#4DFFFFFF" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#2E3236" />
    <Setter Property="BorderBrush" Value="{StaticResource AureliaAccentBrush}" />
  </Style>

  <!-- A card on a shelf or grid: no button chrome, a gentle lift on hover, pressed down a little. -->
  <Style Selector="Button.card">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.card /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.card:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.035) translateY(-3px)" />
  </Style>
  <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.card:pressed">
    <Setter Property="RenderTransform" Value="scale(0.96)" />
  </Style>
  <Style Selector="Button.card:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AureliaAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- The paging arrows on a shelf. -->
  <Style Selector="Button.railArrow">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="52" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="#CC23272B" />
    <Setter Property="Foreground" Value="{StaticResource AureliaPrimaryTextBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.railArrow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#E6383C40" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
  </Style>

  <!-- Filter chips on library pages. -->
  <Style Selector="ToggleButton.chip, Button.chip">
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Background" Value="{StaticResource AureliaSurfaceBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AureliaPrimaryTextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F5F5F7" />
    <Setter Property="Foreground" Value="#111316" />
  </Style>
  <Style Selector="ToggleButton.chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#111316" />
  </Style>

  <!-- A round action next to the hero's main button (favorite, watchlist, more). -->
  <Style Selector="Button.heroAction">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Background" Value="#66383C40" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.heroAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#99484C52" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- A sheet over the dimmed window. -->
  <Style Selector="Border.sheet">
    <Setter Property="Background" Value="#2A2E32" />
    <Setter Property="CornerRadius" Value="{StaticResource AureliaCardRadius}" />
    <Setter Property="Padding" Value="26" />
    <Setter Property="BorderBrush" Value="#26FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 20 60 0 #80000000" />
  </Style>
  <Style Selector="Button.destructive">
    <Setter Property="Background" Value="#C8423A" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Padding" Value="16,6" />
  </Style>
  <Style Selector="Button.destructive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#DE4B42" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Border.banner">
    <Setter Property="Background" Value="#F02A2E32" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="BorderBrush" Value="#33FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 10 30 0 #66000000" />
  </Style>

  <!-- Player controls over the picture, drawn like the Mac's: glass capsules with plain symbols. -->
  <Style Selector="Border.playerMaterial">
    <Setter Property="Background" Value="#B3202124" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 6 24 0 #40000000" />
  </Style>
  <Style Selector="Border.playerCapsule">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="Border.playerPill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="14,8" />
  </Style>
  <Style Selector="Border.playerPanel">
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="24,20" />
  </Style>
  <Style Selector="Button.playerControl">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="19" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#F2FFFFFF" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.playerControl:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1FFFFFFF" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.playerControl:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#14FFFFFF" />
    <Setter Property="Foreground" Value="#D1FFFFFF" />
  </Style>
  <Style Selector="Button.playerControl:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#4DFFFFFF" />
  </Style>
  <Style Selector="Button.playerControl.active">
    <Setter Property="Foreground" Value="{StaticResource AureliaAccentBrush}" />
  </Style>
  <!-- The Back button stands alone in its own glass circle. -->
  <Style Selector="Button.playerControl.playerMaterial">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Background" Value="#B3202124" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.playerControl.playerMaterial:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#CC2C2D31" />
  </Style>
  <Style Selector="Button.playerPrimary">
    <Setter Property="Width" Value="50" />
    <Setter Property="Height" Value="50" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="25" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#000000" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.playerPrimary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F2FFFFFF" />
    <Setter Property="Foreground" Value="#000000" />
  </Style>
  <Style Selector="Button.playerPrimary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#D1FFFFFF" />
    <Setter Property="Foreground" Value="#000000" />
  </Style>
  <!-- The timeline and volume: a thin white line on a faint track, as on the Mac. -->
  <Style Selector="Slider.timeline, Slider.volume">
    <Style.Resources>
      <SolidColorBrush x:Key="SliderTrackFill" Color="#40FFFFFF" />
      <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#59FFFFFF" />
      <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#59FFFFFF" />
      <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#E6FFFFFF" />
    </Style.Resources>
  </Style>
  <Style Selector="TextBlock.playerTime">
    <Setter Property="Foreground" Value="#D9FFFFFF" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="Border.upNext">
    <Setter Property="Background" Value="#E6202326" />
    <Setter Property="CornerRadius" Value="{StaticResource AureliaCardRadius}" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="BorderBrush" Value="#33FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.previewBubble">
    <Setter Property="Background" Value="#E6202326" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="8" />
  </Style>

  <Style Selector="Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#4DFFFFFF" />
  </Style>
</Styles>
