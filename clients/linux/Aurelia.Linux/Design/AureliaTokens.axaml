<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- The Aurelia design tokens, taken from the Mac app's AureliaDesign.swift. The neutral canvas is
       a measured reference value; artwork is responsible for all strong color in Aurelia. -->
  <Color x:Key="AureliaCanvasColor">#202326</Color>
  <Color x:Key="AureliaCanvasTopColor">#1B1E21</Color>
  <Color x:Key="AureliaSurfaceColor">#282C2F</Color>
  <Color x:Key="AureliaRaisedSurfaceColor">#3A3E42</Color>
  <Color x:Key="AureliaAccentColor">#0A84FF</Color>
  <Color x:Key="AureliaPrimaryTextColor">#F5F5F7</Color>
  <Color x:Key="AureliaSubduedTextColor">#99EBEBF5</Color>

  <SolidColorBrush x:Key="AureliaCanvasBrush" Color="{StaticResource AureliaCanvasColor}" />
  <SolidColorBrush x:Key="AureliaSurfaceBrush" Color="{StaticResource AureliaSurfaceColor}" />
  <SolidColorBrush x:Key="AureliaRaisedSurfaceBrush" Color="{StaticResource AureliaRaisedSurfaceColor}" />
  <SolidColorBrush x:Key="AureliaAccentBrush" Color="{StaticResource AureliaAccentColor}" />
  <SolidColorBrush x:Key="AureliaPrimaryTextBrush" Color="{StaticResource AureliaPrimaryTextColor}" />
  <SolidColorBrush x:Key="AureliaSubduedTextBrush" Color="{StaticResource AureliaSubduedTextColor}" />
  <SolidColorBrush x:Key="AureliaHairlineBrush" Color="#B8FFFFFF" Opacity="0.1" />
  <SolidColorBrush x:Key="AureliaHoverBrush" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="AureliaSelectionBrush" Color="#24FFFFFF" />

  <!-- The backdrop behind every page: a slightly darker top fading into the canvas. -->
  <LinearGradientBrush x:Key="AureliaBackdropBrush" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="{StaticResource AureliaCanvasTopColor}" />
    <GradientStop Offset="0.5" Color="{StaticResource AureliaCanvasColor}" />
    <GradientStop Offset="1" Color="{StaticResource AureliaCanvasColor}" />
  </LinearGradientBrush>

  <x:Double x:Key="AureliaPagePadding">32</x:Double>
  <x:Double x:Key="AureliaSectionSpacing">30</x:Double>
  <x:Double x:Key="AureliaRowSpacing">20</x:Double>
  <x:Double x:Key="AureliaSidebarWidth">236</x:Double>
  <x:Double x:Key="AureliaMinimumControlSize">44</x:Double>
  <CornerRadius x:Key="AureliaCardRadius">18</CornerRadius>
  <CornerRadius x:Key="AureliaCompactRadius">12</CornerRadius>
  <CornerRadius x:Key="AureliaHeroRadius">24</CornerRadius>
  <Thickness x:Key="AureliaPageMargin">32</Thickness>

  <FontFamily x:Key="AureliaFontFamily">fonts:Inter#Inter, $Default</FontFamily>
  <x:Double x:Key="AureliaBodyFontSize">14</x:Double>
  <x:Double x:Key="AureliaPageTitleFontSize">34</x:Double>
  <x:Double x:Key="AureliaHeroTitleFontSize">44</x:Double>
  <x:Double x:Key="AureliaSectionTitleFontSize">20</x:Double>

  <!-- Dropdowns and menus like the Mac's: dark rounded panels, a blue highlight on the item under
       the pointer, and fields in the surface color instead of the theme's square boxes. -->
  <CornerRadius x:Key="ControlCornerRadius">9</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">11</CornerRadius>
  <SolidColorBrush x:Key="ComboBoxBackground" Color="#2B2F33" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#33373C" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#26292D" />
  <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#2B2F33" />
  <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxForeground" Color="#F2FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F72A2D31" />
  <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#2BFFFFFF" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource AureliaAccentColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#24FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource AureliaAccentColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#0070E0" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#0070E0" />
  <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#F72A2D31" />
  <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#2BFFFFFF" />
  <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#F2FFFFFF" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource AureliaAccentColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#0070E0" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#FFFFFF" />
  <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundSubMenuOpened" Color="#24FFFFFF" />
  <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#99FFFFFF" />
</ResourceDictionary>
