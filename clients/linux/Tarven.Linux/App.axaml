<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tarven.Linux.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://tarven-desktop/Design/TarvenTokens.axaml" />
        <ResourceInclude Source="avares://tarven-desktop/Design/TarvenIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://tarven-desktop/Design/TarvenStyles.axaml" />
  </Application.Styles>
</Application>
