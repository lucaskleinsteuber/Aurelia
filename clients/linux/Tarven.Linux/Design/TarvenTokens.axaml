<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- The Tarven design tokens, taken from the Mac app's TarvenDesign.swift. The neutral canvas is
       a measured reference value; artwork is responsible for all strong color in Tarven. -->
  <Color x:Key="TarvenCanvasColor">#202326</Color>
  <Color x:Key="TarvenCanvasTopColor">#1B1E21</Color>
  <Color x:Key="TarvenSurfaceColor">#282C2F</Color>
  <Color x:Key="TarvenRaisedSurfaceColor">#3A3E42</Color>
  <Color x:Key="TarvenAccentColor">#0A84FF</Color>
  <Color x:Key="TarvenPrimaryTextColor">#F5F5F7</Color>
  <Color x:Key="TarvenSubduedTextColor">#99EBEBF5</Color>

  <SolidColorBrush x:Key="TarvenCanvasBrush" Color="{StaticResource TarvenCanvasColor}" />
  <SolidColorBrush x:Key="TarvenSurfaceBrush" Color="{StaticResource TarvenSurfaceColor}" />
  <SolidColorBrush x:Key="TarvenRaisedSurfaceBrush" Color="{StaticResource TarvenRaisedSurfaceColor}" />
  <SolidColorBrush x:Key="TarvenAccentBrush" Color="{StaticResource TarvenAccentColor}" />
  <SolidColorBrush x:Key="TarvenPrimaryTextBrush" Color="{StaticResource TarvenPrimaryTextColor}" />
  <SolidColorBrush x:Key="TarvenSubduedTextBrush" Color="{StaticResource TarvenSubduedTextColor}" />
  <SolidColorBrush x:Key="TarvenHairlineBrush" Color="#B8FFFFFF" Opacity="0.1" />
  <SolidColorBrush x:Key="TarvenHoverBrush" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="TarvenSelectionBrush" Color="#24FFFFFF" />

  <!-- The backdrop behind every page: a slightly darker top fading into the canvas. -->
  <LinearGradientBrush x:Key="TarvenBackdropBrush" StartPoint="50%,0%" EndPoint="50%,100%">
    <GradientStop Offset="0" Color="{StaticResource TarvenCanvasTopColor}" />
    <GradientStop Offset="0.5" Color="{StaticResource TarvenCanvasColor}" />
    <GradientStop Offset="1" Color="{StaticResource TarvenCanvasColor}" />
  </LinearGradientBrush>

  <x:Double x:Key="TarvenPagePadding">32</x:Double>
  <x:Double x:Key="TarvenSectionSpacing">30</x:Double>
  <x:Double x:Key="TarvenRowSpacing">20</x:Double>
  <x:Double x:Key="TarvenSidebarWidth">236</x:Double>
  <x:Double x:Key="TarvenMinimumControlSize">44</x:Double>
  <CornerRadius x:Key="TarvenCardRadius">18</CornerRadius>
  <CornerRadius x:Key="TarvenCompactRadius">12</CornerRadius>
  <CornerRadius x:Key="TarvenHeroRadius">24</CornerRadius>
  <Thickness x:Key="TarvenPageMargin">32</Thickness>

  <FontFamily x:Key="TarvenFontFamily">fonts:Inter#Inter, $Default</FontFamily>
  <x:Double x:Key="TarvenBodyFontSize">14</x:Double>
  <x:Double x:Key="TarvenPageTitleFontSize">34</x:Double>
  <x:Double x:Key="TarvenHeroTitleFontSize">44</x:Double>
  <x:Double x:Key="TarvenSectionTitleFontSize">20</x:Double>

  <!-- Dropdowns and menus like the Mac's: dark rounded panels, a blue highlight on the item under
       the pointer, and fields in the surface color instead of the theme's square boxes. -->
  <CornerRadius x:Key="ControlCornerRadius">9</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">11</CornerRadius>
  <SolidColorBrush x:Key="ComboBoxBackground" Color="#2B2F33" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#33373C" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#26292D" />
  <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#2B2F33" />
  <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxForeground" Color="#F2FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F72A2D31" />
  <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#2BFFFFFF" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource TarvenAccentColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#24FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource TarvenAccentColor}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#0070E0" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#0070E0" />
  <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#F72A2D31" />
  <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#2BFFFFFF" />
  <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#F2FFFFFF" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource TarvenAccentColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#FFFFFF" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#0070E0" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#FFFFFF" />
  <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundSubMenuOpened" Color="#24FFFFFF" />
  <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#99FFFFFF" />
</ResourceDictionary>
