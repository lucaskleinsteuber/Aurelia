<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The executable is installed as /usr/bin/tarven-desktop; `tarven` belongs to the server package. -->
    <AssemblyName>tarven-desktop</AssemblyName>
    <RootNamespace>Tarven.Linux</RootNamespace>
    <!-- Video frames are copied between VLC's buffers and the screen without extra allocations. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The published app comes compiled ahead of time. Measured 15.11.2026 on an i5-10500H: while
         opening titles and pages, a quarter of its processor time went into compiling its own code,
         and the interface ran unoptimized code meanwhile. Builds without a runtime (tests) stay as they are. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <!-- Without profile-guided recompiling the precompiled code is not compiled a second and third
         time in the background: the same clicks took 7.7 s of processor time instead of 11.2 s. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Wayland" />
    <PackageReference Include="LibVLCSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Tarven.Linux.Core/Tarven.Linux.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tarven.Linux.Tests" />
  </ItemGroup>
</Project>
