<Project>
  <!-- Aurelia for Linux is its own product with its own version and build counter (see AGENTS.md). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <AureliaLinuxBuildNumber>25</AureliaLinuxBuildNumber>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.$(AureliaLinuxBuildNumber)</FileVersion>
    <InformationalVersion>2.0.0+build.$(AureliaLinuxBuildNumber)</InformationalVersion>
  </PropertyGroup>
</Project>
