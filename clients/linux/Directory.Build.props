<Project>
  <!-- Aurelia for Linux is its own product with its own version and build counter (see AGENTS.md). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <AureliaLinuxBuildNumber>33</AureliaLinuxBuildNumber>
    <Version>2.8.0</Version>
    <FileVersion>2.8.0.$(AureliaLinuxBuildNumber)</FileVersion>
    <InformationalVersion>2.8.0+build.$(AureliaLinuxBuildNumber)</InformationalVersion>
  </PropertyGroup>
</Project>
