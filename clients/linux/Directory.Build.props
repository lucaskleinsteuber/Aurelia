<Project>
  <!-- Aurelia for Linux is its own product with its own version and build counter (see AGENTS.md). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <AureliaLinuxBuildNumber>8</AureliaLinuxBuildNumber>
    <Version>1.0.2</Version>
    <FileVersion>1.0.2.$(AureliaLinuxBuildNumber)</FileVersion>
    <InformationalVersion>1.0.2+build.$(AureliaLinuxBuildNumber)</InformationalVersion>
  </PropertyGroup>
</Project>
