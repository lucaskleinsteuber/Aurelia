<Project>
  <!-- Aurelia for Linux is its own product with its own version and build counter (see AGENTS.md). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <AureliaLinuxBuildNumber>11</AureliaLinuxBuildNumber>
    <Version>1.2.1</Version>
    <FileVersion>1.2.1.$(AureliaLinuxBuildNumber)</FileVersion>
    <InformationalVersion>1.2.1+build.$(AureliaLinuxBuildNumber)</InformationalVersion>
  </PropertyGroup>
</Project>
