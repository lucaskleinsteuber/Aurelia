<Project>
  <!-- Aurelia for Linux is its own product with its own version and build counter (see AGENTS.md). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <AureliaLinuxBuildNumber>40</AureliaLinuxBuildNumber>
    <Version>2.11.1</Version>
    <FileVersion>2.11.1.$(AureliaLinuxBuildNumber)</FileVersion>
    <InformationalVersion>2.11.1+build.$(AureliaLinuxBuildNumber)</InformationalVersion>
  </PropertyGroup>
</Project>
