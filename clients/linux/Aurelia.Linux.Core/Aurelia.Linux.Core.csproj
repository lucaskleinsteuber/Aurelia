<Project Sdk="Microsoft.NET.Sdk">
  <!-- App logic without any UI toolkit, so it can be tested on its own. -->
  <PropertyGroup>
    <RootNamespace>Aurelia.Linux.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Haukcode.Mdns" />
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Aurelia.Linux.Tests" />
    <InternalsVisibleTo Include="Aurelia.Linux.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Settings › About shows what changed in this version. -->
    <EmbeddedResource Include="../../../CHANGELOG.md" LogicalName="CHANGELOG.md" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Aurelia.Contracts/Aurelia.Contracts.csproj" />
  </ItemGroup>
</Project>
