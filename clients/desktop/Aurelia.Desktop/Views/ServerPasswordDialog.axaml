<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Aurelia.Desktop.Views.ServerPasswordDialog"
        Title="Server Password"
        Icon="avares://Aurelia/Assets/aurelia.ico"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AureliaSurface}">
  <!-- Management opens with the Server Password for ten minutes, as on the Mac. -->
  <StackPanel Margin="28,24" Spacing="14">
    <TextBlock Classes="title" Text="Server Password" />
    <TextBlock Classes="secondary" TextWrapping="Wrap"
               Text="Enter the Server Password to manage this server. Access lasts ten minutes." />
    <TextBox x:Name="PasswordBox" PasswordChar="•" PlaceholderText="Server Password" KeyDown="PasswordKeyDown" />
    <TextBlock x:Name="ProblemText" Foreground="#FF8A80" TextWrapping="Wrap" IsVisible="False" />
    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
      <Button Classes="secondary" Content="Cancel" Click="Cancel" />
      <Button x:Name="UnlockButton" Classes="primary" Content="Unlock" Click="Unlock" />
    </StackPanel>
  </StackPanel>
</Window>
