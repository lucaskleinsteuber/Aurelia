<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Aurelia.Desktop.Core;assembly=Aurelia.Desktop.Core"
             x:Class="Aurelia.Desktop.Views.HostSetupView"
             x:DataType="core:HostSetupFlow">
  <!-- "Set Up This PC": one centered card per step, the same design as connecting to a server. -->
  <Grid>
    <Border Background="{StaticResource AureliaSurface}" CornerRadius="18" Padding="36,32"
            Width="560" HorizontalAlignment="Center" VerticalAlignment="Center"
            BoxShadow="0 18 48 0 #66000000">
      <StackPanel Spacing="14">
        <TextBlock Text="Aurelia" FontSize="13" FontWeight="Bold" LetterSpacing="1.2"
                   Foreground="{StaticResource AureliaSecondaryText}" />

        <!-- Where the server runs -->
        <StackPanel x:Name="ChooseStep" Spacing="16" IsVisible="{Binding ShowsChoose}">
          <TextBlock Classes="title" Text="Welcome to Aurelia" />
          <TextBlock Classes="secondary" Text="Choose where your private media server should run." />
          <Button x:Name="ChooseHostButton" Classes="choice" Click="ChooseHost" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Width="44" Height="44" CornerRadius="12" Background="White" VerticalAlignment="Center">
                <!-- A display on a stand: this computer. -->
                <Path Data="M4,5 H20 V15 H4 Z M9,19 H15 M12,15 V19" Stroke="Black" StrokeThickness="2" StrokeJoin="Round"
                      StrokeLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="16,0" VerticalAlignment="Center">
                <TextBlock x:Name="HostChoiceTitle" Text="Set Up This PC" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Classes="secondary" FontSize="13" Text="Recommended · Aurelia starts and stops the server for you." />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="›" FontSize="20" Foreground="{StaticResource AureliaSecondaryText}" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button x:Name="ChooseClientButton" Classes="choice quiet" Click="ChooseClient" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Width="44" Height="44" CornerRadius="12" Background="#1FFFFFFF" VerticalAlignment="Center">
                <TextBlock Text="⇄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="16,0" VerticalAlignment="Center">
                <TextBlock Text="Connect to an Existing Server" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Classes="secondary" FontSize="13" Text="For a server that runs on another computer, such as your Mac." />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="›" FontSize="20" Foreground="{StaticResource AureliaSecondaryText}" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>

        <!-- Starting or restarting -->
        <StackPanel x:Name="StartingStep" Spacing="14" IsVisible="{Binding ShowsStarting}">
          <TextBlock Classes="title" Text="{Binding StatusTitle}" />
          <ProgressBar IsIndeterminate="True" />
          <TextBlock Classes="secondary" Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <!-- The server could not start -->
        <StackPanel x:Name="FailedStep" Spacing="14" IsVisible="{Binding ShowsFailed}">
          <TextBlock Classes="title" Text="Your Server Needs Attention" />
          <TextBlock Classes="secondary" Text="{Binding StatusMessage}" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="RetryButton" Classes="primary" Content="Try Again" Click="Retry" IsEnabled="{Binding !IsBusy}" />
            <Button Classes="secondary" Content="Connect to Another Server" Click="UseAnotherServer" />
          </StackPanel>
        </StackPanel>

        <!-- A new server: the owner's Server Password -->
        <StackPanel x:Name="OwnerStep" Spacing="12" IsVisible="{Binding ShowsOwnerSetup}">
          <TextBlock x:Name="OwnerTitle" Classes="title" Text="Set Up This PC" />
          <TextBlock Classes="secondary" Text="Choose a Server Password. Aurelia takes care of the server details." />
          <TextBox x:Name="SetupPassword" PasswordChar="•" PlaceholderText="Server Password (at least 12 characters)" />
          <TextBox x:Name="SetupConfirmation" PasswordChar="•" PlaceholderText="Confirm Server Password" KeyDown="SetupKeyDown" />
          <Button x:Name="AdvancedButton" Classes="link" Content="Advanced ›" Click="ToggleAdvanced" />
          <Border x:Name="AdvancedPanel" IsVisible="False">
            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="10">
              <TextBlock Text="Server Name" VerticalAlignment="Center" />
              <TextBox x:Name="ServerNameBox" Grid.Column="1" Text="{Binding ServerName}" MaxLength="128" />
              <TextBlock Grid.Row="1" Text="Owner Name" VerticalAlignment="Center" />
              <TextBox x:Name="OwnerNameBox" Grid.Row="1" Grid.Column="1" Text="{Binding OwnerName}" MaxLength="64" />
            </Grid>
          </Border>
          <TextBlock x:Name="FirewallHint" Classes="secondary" FontSize="12" IsVisible="False"
                     Text="Windows may ask whether Aurelia Server may use your network. Choose Allow, so your Apple TV and other devices can connect." />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="SetupButton" Classes="primary" Content="Continue" Click="SetUp" IsEnabled="{Binding !IsBusy}" />
            <Button Classes="link" Content="Connect to Another Server" Click="UseAnotherServer" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <!-- Set up earlier, but this app has no saved sign-in -->
        <StackPanel x:Name="SignInStep" Spacing="12" IsVisible="{Binding ShowsSignIn}">
          <TextBlock Classes="title" Text="Welcome Back" />
          <TextBlock Classes="secondary" Text="Sign in to the Aurelia server already stored on this computer." />
          <TextBox x:Name="SignInName" Text="{Binding OwnerName}" PlaceholderText="Owner name" />
          <TextBox x:Name="SignInPassword" PasswordChar="•" PlaceholderText="Server Password" KeyDown="SignInKeyDown" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="SignInButton" Classes="primary" Content="Sign In" Click="SignIn" IsEnabled="{Binding !IsBusy}" />
            <Button Classes="link" Content="Connect to Another Server" Click="UseAnotherServer" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <!-- The owner's viewing PIN -->
        <StackPanel x:Name="PinStep" Spacing="12" IsVisible="{Binding ShowsCreatePin}">
          <TextBlock Classes="title" Text="Choose Your Viewing PIN" />
          <TextBlock Classes="secondary" Text="Your profile opens with this PIN on every device, such as your Apple TV. Use four to eight digits." />
          <TextBox x:Name="NewPin" PasswordChar="•" MaxLength="8" PlaceholderText="PIN" FontSize="20" HorizontalContentAlignment="Center" />
          <TextBox x:Name="NewPinConfirmation" PasswordChar="•" MaxLength="8" PlaceholderText="Confirm PIN" FontSize="20"
                   HorizontalContentAlignment="Center" KeyDown="PinKeyDown" />
          <TextBox x:Name="PinPassword" PasswordChar="•" PlaceholderText="Server Password" IsVisible="{Binding NeedsPasswordForPin}" />
          <Button x:Name="PinButton" Classes="primary" Content="Continue" Click="CreatePin" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <!-- A forgotten owner PIN -->
        <StackPanel x:Name="ResetStep" Spacing="12" IsVisible="{Binding ShowsResetPin}">
          <TextBlock Classes="title" Text="Reset Your PIN" />
          <TextBlock Classes="secondary" Text="Enter the Server Password of this computer's server and choose a new viewing PIN." />
          <TextBox x:Name="ResetPassword" PasswordChar="•" PlaceholderText="Server Password" />
          <TextBox x:Name="ResetPin" PasswordChar="•" MaxLength="8" PlaceholderText="New PIN" />
          <TextBox x:Name="ResetPinConfirmation" PasswordChar="•" MaxLength="8" PlaceholderText="Confirm New PIN" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="ResetButton" Classes="primary" Content="Reset PIN" Click="ResetPinClicked" IsEnabled="{Binding !IsBusy}" />
            <Button Classes="secondary" Content="Cancel" Click="CancelReset" />
          </StackPanel>
        </StackPanel>

        <!-- The first storage locations -->
        <StackPanel x:Name="StorageStep" Spacing="12" IsVisible="{Binding ShowsStorage}">
          <TextBlock Classes="title" Text="Choose Storage Locations" />
          <TextBlock Classes="secondary"
                     Text="Select a drive or folder. Aurelia recognizes movies and TV shows for you. Your files are only read, never changed or moved." />
          <ItemsControl x:Name="Locations" ItemsSource="{Binding Locations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:StorageDraft">
                <Border Background="#14FFFFFF" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Path}" Classes="caption" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Margin="10,0" Width="190" VerticalAlignment="Center"
                              SelectedIndex="0" SelectionChanged="KindChanged">
                      <ComboBoxItem Content="Movies and TV Shows" />
                      <ComboBoxItem Content="Movies" />
                      <ComboBoxItem Content="TV Shows" />
                    </ComboBox>
                    <Button Grid.Column="2" Classes="link" Content="Remove" Click="RemoveLocation" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="ChooseFoldersButton" Classes="secondary" Content="Choose Storage Locations…" Click="ChooseFolders" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="ImportButton" Classes="primary" Content="Add to Aurelia" Click="Import"
                    IsEnabled="{Binding HasLocations}" />
            <Button Classes="secondary" Content="Skip for Now" Click="SkipStorage" />
          </StackPanel>
        </StackPanel>

        <!-- The first scan -->
        <StackPanel x:Name="ScanningStep" Spacing="14" IsVisible="{Binding ShowsScanning}">
          <TextBlock Classes="title" Text="Adding Your Media" />
          <ProgressBar IsIndeterminate="True" />
          <TextBlock x:Name="ScanText" Classes="secondary" Text="{Binding ScanProgress}" />
          <Button Classes="secondary" Content="Continue to Library" Click="ContinueToLibrary" />
          <TextBlock Classes="secondary" FontSize="12" Text="Scanning continues in the background." />
        </StackPanel>

        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
        <TextBlock x:Name="ErrorText" Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#FF8A80" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
