<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Aurelia.Desktop.Core;assembly=Aurelia.Desktop.Core"
             xmlns:contracts="clr-namespace:Aurelia.Contracts;assembly=Aurelia.Contracts"
             xmlns:controls="clr-namespace:Aurelia.Desktop.Controls"
             xmlns:design="clr-namespace:Aurelia.Desktop.Design"
             x:Class="Aurelia.Desktop.Views.LibraryView"
             x:DataType="core:LibraryModel">
  <UserControl.Resources>
    <!-- A poster card, as in the Mac library: artwork, title, year, and progress when started. -->
    <DataTemplate x:Key="PosterCard" x:DataType="contracts:CatalogItemSummary">
      <Button Classes="card" Click="OpenItem" Width="160" Margin="0,0,18,0" ToolTip.Tip="{Binding Title}">
        <StackPanel Spacing="6">
          <Border Width="160" Height="240" CornerRadius="10" ClipToBounds="True">
            <Panel>
              <controls:ArtworkImage Artwork="{Binding Poster}" DecodeWidth="320" />
              <ProgressBar Classes="card" VerticalAlignment="Bottom" Margin="8"
                           Value="{Binding Progress, Converter={x:Static design:ProgressFractionConverter.Instance}}"
                           IsVisible="{Binding Progress, Converter={x:Static design:InProgressConverter.Instance}}" />
              <Border Classes="watched" IsVisible="{Binding Progress, Converter={x:Static design:WatchedConverter.Instance}}"
                      ToolTip.Tip="Watched">
                <TextBlock Text="✓" />
              </Border>
            </Panel>
          </Border>
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="caption" Text="{Binding ., Converter={x:Static design:CardCaptionConverter.Instance}}" />
        </StackPanel>
      </Button>
    </DataTemplate>
    <!-- Continue Watching: a landscape card with the episode and its progress inside the picture. -->
    <DataTemplate x:Key="LandscapeCard" x:DataType="contracts:CatalogItemSummary">
      <Button Classes="card" Click="OpenItem" Width="320" Margin="0,0,18,0">
        <Border Width="320" Height="180" CornerRadius="10" ClipToBounds="True">
          <Panel>
            <controls:ArtworkImage Artwork="{Binding ., Converter={x:Static design:HeroArtworkConverter.Instance}}" DecodeWidth="640" />
            <Border VerticalAlignment="Bottom" Padding="12,24,12,10">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="#D0000000" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="caption" Text="{Binding ., Converter={x:Static design:CardCaptionConverter.Instance}}" />
                <ProgressBar Classes="card"
                             Value="{Binding Progress, Converter={x:Static design:ProgressFractionConverter.Instance}}"
                             IsVisible="{Binding Progress, Converter={x:Static design:InProgressConverter.Instance}}" />
              </StackPanel>
            </Border>
          </Panel>
        </Border>
      </Button>
    </DataTemplate>
    <!-- Sorting and filters above Movies and TV Shows, as the Mac library's filter bar. -->
    <DataTemplate x:Key="FilterBar" x:DataType="core:CatalogBrowse">
      <WrapPanel ItemSpacing="10" LineSpacing="10">
        <ComboBox x:Name="SortPicker" ItemsSource="{x:Static core:CatalogBrowse.SortNames}" SelectedIndex="{Binding SortIndex}"
                  MinWidth="150" ToolTip.Tip="Sort by" />
        <Button Classes="secondary" Content="{Binding DirectionText}" Click="ToggleDirection" MinWidth="40"
                ToolTip.Tip="Ascending or descending" />
        <ComboBox x:Name="WatchPicker" ItemsSource="{x:Static core:CatalogBrowse.WatchNames}" SelectedIndex="{Binding WatchIndex}"
                  MinWidth="130" ToolTip.Tip="Watched" />
        <ComboBox x:Name="GenrePicker" ItemsSource="{Binding Genres}" SelectedItem="{Binding Genre}" MinWidth="150" ToolTip.Tip="Genre" />
        <ComboBox x:Name="YearPicker" ItemsSource="{Binding Years}" SelectedItem="{Binding Year}" MinWidth="110" ToolTip.Tip="Release year" />
        <Button Classes="link" Content="Clear Filters" Click="ClearFilters" IsVisible="{Binding HasFilters}" VerticalAlignment="Center" />
        <TextBlock Classes="caption" Text="{Binding CountText}" VerticalAlignment="Center" />
      </WrapPanel>
    </DataTemplate>
    <design:CardTemplateConverter x:Key="CardTemplates" Poster="{StaticResource PosterCard}" Landscape="{StaticResource LandscapeCard}" />
  </UserControl.Resources>

  <Grid ColumnDefinitions="232,*">
    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{StaticResource AureliaSidebar}"
            BorderBrush="{StaticResource AureliaHairline}" BorderThickness="0,0,1,0">
      <DockPanel x:Name="SidebarContent" Margin="14,22,14,18">
        <TextBlock DockPanel.Dock="Top" Text="Aurelia" FontSize="22" FontWeight="Bold" Margin="12,0,0,22" />
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="12,0,0,0">
          <Button x:Name="ServerSettingsButton" Classes="link" Content="Server Settings…" Click="OpenServerSettings" IsVisible="False" />
          <TextBlock x:Name="ProfileName" FontWeight="SemiBold" />
          <Button x:Name="AppSettingsButton" Classes="link" Content="Settings…" Click="OpenAppSettings" />
          <Button Classes="link" Content="Switch Profile" Click="SwitchProfile" />
          <TextBlock x:Name="VersionLabel" FontSize="11" Foreground="{StaticResource AureliaSecondaryText}" />
        </StackPanel>
        <ListBox x:Name="Navigation" Classes="sidebar" SelectedIndex="0" SelectionChanged="SectionChanged">
          <ListBoxItem Content="Home" />
          <ListBoxItem Content="Movies" />
          <ListBoxItem Content="TV Shows" />
          <ListBoxItem Content="Search" />
        </ListBox>
      </DockPanel>
    </Border>

    <Panel Grid.Column="1">
      <!-- Home -->
      <ScrollViewer x:Name="HomeScroll" IsVisible="{Binding ShowsHome}">
        <StackPanel Spacing="28" Margin="0,0,0,40">
          <Panel x:Name="Hero" Height="460" IsVisible="{Binding HasHero}">
            <controls:ArtworkImage Artwork="{Binding Hero, Converter={x:Static design:HeroArtworkConverter.Instance}}" DecodeWidth="1920" />
            <Border>
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Color="#E6202326" Offset="0" />
                  <GradientStop Color="#00202326" Offset="0.7" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Border>
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Color="#00202326" Offset="0.55" />
                  <GradientStop Color="#FF202326" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <StackPanel Spacing="10" Margin="48,0,0,40" VerticalAlignment="Bottom" MaxWidth="560" HorizontalAlignment="Left">
              <TextBlock Classes="eyebrow" Text="{Binding HeroEyebrow}" />
              <TextBlock x:Name="HeroTitle" Text="{Binding Hero.Title, FallbackValue=''}" FontSize="40" FontWeight="Bold" TextWrapping="Wrap" />
              <TextBlock Classes="secondary" Text="{Binding Hero.Overview, FallbackValue=''}" MaxLines="3" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                <Button Classes="primary" Content="▶  Play" Click="PlayHero" />
                <Button Classes="secondary" Content="Details" Click="OpenHero" />
              </StackPanel>
            </StackPanel>
          </Panel>
          <ItemsControl x:Name="HomeRows" ItemsSource="{Binding Rows}" Margin="48,0,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:HomeRow">
                <StackPanel Spacing="12" Margin="0,0,0,26">
                  <TextBlock Classes="section" Text="{Binding Title}" />
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Items}"
                                  ItemTemplate="{ReflectionBinding Landscape, Converter={StaticResource CardTemplates}}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="secondary" Margin="48,0" IsVisible="{Binding IsHomeEmpty}"
                     Text="Nothing to show yet. Add movies and shows in Aurelia on your Mac." />
        </StackPanel>
      </ScrollViewer>

      <!-- Movies and TV Shows -->
      <ScrollViewer x:Name="MoviesScroll" IsVisible="{Binding ShowsMovies}" ScrollChanged="GridScrolled">
        <StackPanel Margin="48,36,24,40" Spacing="20">
          <TextBlock Classes="page" Text="Movies" />
          <ContentControl Content="{Binding MovieBrowse}" ContentTemplate="{StaticResource FilterBar}" />
          <TextBlock Classes="secondary" Text="{Binding MovieBrowse.EmptyText}" IsVisible="{Binding MovieBrowse.IsEmpty}" />
          <ItemsControl x:Name="MovieGrid" ItemsSource="{Binding Movies}" ItemTemplate="{StaticResource PosterCard}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="0" LineSpacing="26" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="ShowsScroll" IsVisible="{Binding ShowsShows}" ScrollChanged="GridScrolled">
        <StackPanel Margin="48,36,24,40" Spacing="20">
          <TextBlock Classes="page" Text="TV Shows" />
          <ContentControl Content="{Binding ShowBrowse}" ContentTemplate="{StaticResource FilterBar}" />
          <TextBlock Classes="secondary" Text="{Binding ShowBrowse.EmptyText}" IsVisible="{Binding ShowBrowse.IsEmpty}" />
          <ItemsControl x:Name="ShowGrid" ItemsSource="{Binding Shows}" ItemTemplate="{StaticResource PosterCard}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="0" LineSpacing="26" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Search -->
      <ScrollViewer IsVisible="{Binding ShowsSearch}">
        <StackPanel Margin="48,36,24,40" Spacing="20">
          <TextBlock Classes="page" Text="Search" />
          <TextBox x:Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="Movies, shows and episodes" MaxWidth="560"
                   HorizontalAlignment="Left" Width="560" />
          <TextBlock Classes="secondary" Text="No results." IsVisible="{Binding ShowsNoResults}" />
          <ItemsControl x:Name="SearchResults" ItemsSource="{Binding SearchResults}" ItemTemplate="{StaticResource PosterCard}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="0" LineSpacing="26" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Detail page over the section it was opened from -->
      <ScrollViewer x:Name="DetailPage" IsVisible="{Binding ShowsDetail}" Background="{StaticResource AureliaCanvas}">
        <StackPanel Spacing="26" Margin="0,0,0,48">
          <Panel Height="480">
            <controls:ArtworkImage Artwork="{Binding Detail, Converter={x:Static design:HeroArtworkConverter.Instance}}" DecodeWidth="1920" />
            <Border>
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Color="#EE202326" Offset="0" />
                  <GradientStop Color="#00202326" Offset="0.75" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Border>
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Color="#00202326" Offset="0.5" />
                  <GradientStop Color="#FF202326" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Button x:Name="BackButton" Classes="round" Content="‹" Click="CloseDetail" Margin="32,28,0,0" HorizontalAlignment="Left"
                    VerticalAlignment="Top" ToolTip.Tip="Back" />
            <StackPanel Spacing="10" Margin="48,0,0,36" VerticalAlignment="Bottom" MaxWidth="620" HorizontalAlignment="Left">
              <TextBlock x:Name="DetailTitle" Text="{Binding Detail.Metadata.Title, FallbackValue=''}" FontSize="40" FontWeight="Bold"
                         TextWrapping="Wrap" />
              <TextBlock Classes="secondary" Text="{Binding DetailMeta}" />
              <TextBlock Text="{Binding Detail.Metadata.Overview, FallbackValue=''}" TextWrapping="Wrap" MaxLines="5"
                         TextTrimming="CharacterEllipsis" Foreground="#E6FFFFFF" />
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                <Button x:Name="DetailPlay" Classes="primary" Click="PlayDetail">
                  <TextBlock Text="{Binding PlayLabel, StringFormat='▶  {0}'}" />
                </Button>
                <Button Classes="secondary" Content="{Binding FavoriteLabel}" Click="ToggleFavorite" />
                <Button x:Name="WatchedButton" Classes="secondary" Content="{Binding WatchedLabel}" Click="ToggleWatched" />
                <!-- Editing and removing: the owner and administrators only. -->
                <Button x:Name="MoreButton" Classes="round" Content="⋯" IsVisible="{Binding CanManage}" ToolTip.Tip="More">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                      <MenuItem x:Name="EditDetailsItem" Header="Edit Details…" Click="EditDetail" />
                      <MenuItem x:Name="RemoveItem" Header="Remove from Library…" Click="AskRemove" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
              <TextBlock Classes="caption" Text="{Binding PlayHint}" />
            </StackPanel>
          </Panel>

          <!-- Seasons and episodes -->
          <StackPanel Spacing="14" Margin="48,0,24,0" IsVisible="{Binding IsSeries}">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <ComboBox x:Name="SeasonPicker" ItemsSource="{Binding Seasons}" SelectedItem="{Binding SelectedSeason}" MinWidth="180">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="contracts:SeasonPresentation">
                    <TextBlock Text="{Binding ., Converter={x:Static design:SeasonNameConverter.Instance}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button x:Name="SeasonWatchedButton" Classes="link" Content="{Binding SeasonWatchedLabel}" Click="ToggleSeasonWatched"
                      VerticalAlignment="Center" />
            </StackPanel>
            <ItemsControl x:Name="EpisodeList" ItemsSource="{Binding Episodes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="contracts:EpisodePresentation">
                  <Button Classes="episode" Click="PlayEpisode" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Play" Click="PlayEpisode" />
                        <MenuItem Header="{Binding Item.Progress, Converter={x:Static design:WatchedMenuConverter.Instance}}"
                                  Click="ToggleEpisodeWatched" />
                      </ContextMenu>
                    </Button.ContextMenu>
                    <Grid ColumnDefinitions="240,*">
                      <Border Width="240" Height="135" CornerRadius="8" ClipToBounds="True">
                        <Panel>
                          <controls:ArtworkImage Artwork="{Binding Item, Converter={x:Static design:HeroArtworkConverter.Instance}}"
                                                 DecodeWidth="320" />
                          <ProgressBar Classes="card" VerticalAlignment="Bottom" Margin="8"
                                       Value="{Binding Item.Progress, Converter={x:Static design:ProgressFractionConverter.Instance}}"
                                       IsVisible="{Binding Item.Progress, Converter={x:Static design:InProgressConverter.Instance}}" />
                          <Border Classes="watched" IsVisible="{Binding Item.Progress, Converter={x:Static design:WatchedConverter.Instance}}"
                                  ToolTip.Tip="Watched">
                            <TextBlock Text="✓" />
                          </Border>
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="6" Margin="18,6,8,0">
                        <TextBlock Classes="caption" Text="{Binding ., Converter={x:Static design:EpisodeNumberConverter.Instance}}" />
                        <TextBlock Text="{Binding Item.Title}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="secondary" Text="{Binding Item.Overview}" MaxLines="3" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Extras and trailers -->
          <StackPanel Spacing="12" Margin="48,0,24,0" IsVisible="{Binding HasExtras}">
            <TextBlock Classes="section" Text="Extras" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Extras}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="contracts:SupplementPresentation">
                    <Button Classes="card" Click="PlaySupplement" Width="280" Margin="0,0,18,0">
                      <StackPanel Spacing="6">
                        <Border Width="280" Height="158" CornerRadius="10" ClipToBounds="True">
                          <controls:ArtworkImage Artwork="{Binding Item, Converter={x:Static design:HeroArtworkConverter.Instance}}"
                                                 DecodeWidth="640" />
                        </Border>
                        <TextBlock Text="{Binding Item.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="caption" Text="{Binding Category}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Loading and errors stay out of the way -->
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" VerticalAlignment="Top" Height="3" MinHeight="3" />
      <Border x:Name="ErrorBanner" IsVisible="{Binding HasError}" Background="#E6402020" CornerRadius="12" Padding="16,10"
              Margin="24" HorizontalAlignment="Center" VerticalAlignment="Bottom">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <TextBlock x:Name="ErrorText" Text="{Binding Error}" TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center" />
          <Button Classes="secondary" Content="Try Again" Click="Retry" />
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</UserControl>
