<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Aurelia.Desktop.Core;assembly=Aurelia.Desktop.Core"
        x:Class="Aurelia.Desktop.Views.MetadataEditorWindow"
        x:DataType="core:MetadataEditorModel"
        Title="Edit Details"
        Icon="avares://Aurelia/Assets/aurelia.ico"
        Width="920" Height="760" MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AureliaCanvas}">
  <DockPanel>
    <!-- Save and cancel stay at the bottom, as in the Mac editor. -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource AureliaSidebar}" BorderBrush="{StaticResource AureliaHairline}"
            BorderThickness="0,1,0,0" Padding="28,14">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="ErrorText" Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#FF8A80" TextWrapping="Wrap"
                   VerticalAlignment="Center" Margin="0,0,16,0" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
          <Button Classes="secondary" Content="Cancel" Click="Cancel" />
          <Button x:Name="SaveButton" Classes="primary" Content="Save" Click="Save" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer>
      <Grid ColumnDefinitions="260,*" Margin="28,24,28,28">
        <!-- Pictures -->
        <StackPanel Spacing="12">
          <Border Width="240" Height="360" CornerRadius="10" ClipToBounds="True" Background="#14FFFFFF" HorizontalAlignment="Left">
            <Image x:Name="PosterPreview" Stretch="UniformToFill" />
          </Border>
          <TextBlock Classes="caption" Text="{Binding PosterText}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="ChoosePosterButton" Classes="secondary" Content="Choose Poster…" Click="ChoosePoster" IsEnabled="{Binding !IsBusy}" />
            <Button Classes="link" Content="Use Automatic" Click="UseAutomatic" Tag="poster" IsVisible="{Binding PosterIsManual}" />
          </StackPanel>
          <Border Width="240" Height="135" CornerRadius="8" ClipToBounds="True" Background="#14FFFFFF" HorizontalAlignment="Left" Margin="0,14,0,0">
            <Image x:Name="BackdropPreview" Stretch="UniformToFill" />
          </Border>
          <TextBlock Classes="caption" Text="{Binding BackdropText}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="ChooseBackdropButton" Classes="secondary" Click="ChooseBackdrop" IsEnabled="{Binding !IsBusy}"
                    Content="{Binding BackdropName, StringFormat='Choose {0}…'}" />
            <Button Classes="link" Content="Use Automatic" Click="UseAutomatic" Tag="backdrop" IsVisible="{Binding BackdropIsManual}" />
          </StackPanel>
        </StackPanel>

        <!-- Details -->
        <StackPanel Grid.Column="1" Spacing="16" Margin="20,0,0,0" MaxWidth="560" HorizontalAlignment="Left">
          <StackPanel Spacing="4">
            <TextBlock Classes="caption" Text="{Binding KindName}" />
            <TextBlock Classes="page" Text="Edit Details" />
            <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap"
                       Text="Changes apply to this title only. The video file is never changed." />
          </StackPanel>

          <Border Classes="group">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Title" Classes="secondary" />
                <Button Grid.Column="1" Classes="link" Content="Use Automatic" Click="UseAutomatic" Tag="title" IsVisible="{Binding TitleIsManual}" />
              </Grid>
              <TextBox x:Name="TitleBox" Text="{Binding Title}" MaxLength="300" />
              <Grid ColumnDefinitions="*,16,*">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Year" Classes="secondary" />
                    <Button Grid.Column="1" Classes="link" Content="Use Automatic" Click="UseAutomatic" Tag="releaseYear" IsVisible="{Binding YearIsManual}" />
                  </Grid>
                  <TextBox x:Name="YearBox" Text="{Binding Year}" MaxLength="4" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6" IsVisible="{Binding IsMovie}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Runtime (minutes)" Classes="secondary" />
                    <Button Grid.Column="1" Classes="link" Content="Use Automatic" Click="UseAutomatic" Tag="runtimeMinutes" IsVisible="{Binding RuntimeIsManual}" />
                  </Grid>
                  <TextBox x:Name="RuntimeBox" Text="{Binding Runtime}" MaxLength="5" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Description" Classes="secondary" />
                <Button Grid.Column="1" Classes="link" Content="Use Automatic" Click="UseAutomatic" Tag="overview" IsVisible="{Binding OverviewIsManual}" />
              </Grid>
              <TextBox x:Name="OverviewBox" Text="{Binding Overview}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxLength="10000" />
            </StackPanel>
          </Border>

          <Border Classes="group">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Age Rating" Classes="secondary" />
                <Button Grid.Column="1" Classes="link" Content="Use Automatic" Click="UseAutomatic" Tag="fsk" IsVisible="{Binding AgeIsManual}" />
              </Grid>
              <ComboBox x:Name="AgePicker" ItemsSource="{x:Static core:MetadataEditorModel.AgeRatings}" SelectedIndex="{Binding AgeIndex}" MinWidth="180" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Genres, separated by commas" Classes="secondary" />
                <Button Grid.Column="1" Classes="link" Content="Use Automatic" Click="UseAutomatic" Tag="genres" IsVisible="{Binding GenresAreManual}" />
              </Grid>
              <TextBox x:Name="GenresBox" Text="{Binding Genres}" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Studios, separated by commas" Classes="secondary" />
                <Button Grid.Column="1" Classes="link" Content="Use Automatic" Click="UseAutomatic" Tag="studios" IsVisible="{Binding StudiosAreManual}" />
              </Grid>
              <TextBox x:Name="StudiosBox" Text="{Binding Studios}" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Country" Classes="secondary" />
                <Button Grid.Column="1" Classes="link" Content="Use Automatic" Click="UseAutomatic" Tag="country" IsVisible="{Binding CountryIsManual}" />
              </Grid>
              <TextBox x:Name="CountryBox" Text="{Binding Country}" MaxLength="100" />
            </StackPanel>
          </Border>

          <StackPanel Spacing="4">
            <TextBlock Classes="secondary" FontSize="12" Text="Video file" />
            <SelectableTextBlock Classes="caption" Text="{Binding SourcePath}" TextWrapping="Wrap" />
          </StackPanel>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
