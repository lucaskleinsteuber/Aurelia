<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aurelia.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- Aurelia's accent is white, as on the Mac: sliders, progress and focus rings. -->
    <Color x:Key="SystemAccentColor">#FFFFFFFF</Color>
    <Color x:Key="SystemAccentColorLight1">#FFF2F2F2</Color>
    <Color x:Key="SystemAccentColorLight2">#FFE6E6E6</Color>
    <Color x:Key="SystemAccentColorLight3">#FFD9D9D9</Color>
    <Color x:Key="SystemAccentColorDark1">#FFE6E6E6</Color>
    <Color x:Key="SystemAccentColorDark2">#FFCCCCCC</Color>
    <Color x:Key="SystemAccentColorDark3">#FFB3B3B3</Color>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Aurelia/Design/AureliaStyles.axaml" />
  </Application.Styles>
</Application>
