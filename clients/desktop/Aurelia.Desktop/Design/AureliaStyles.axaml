<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The Mac app's design tokens: canvas, raised surface, sidebar and accent. -->
  <Styles.Resources>
    <Color x:Key="AureliaCanvasColor">#202326</Color>
    <Color x:Key="AureliaSurfaceColor">#282C2F</Color>
    <Color x:Key="AureliaSidebarColor">#17191B</Color>
    <SolidColorBrush x:Key="AureliaCanvas" Color="{StaticResource AureliaCanvasColor}" />
    <SolidColorBrush x:Key="AureliaSurface" Color="{StaticResource AureliaSurfaceColor}" />
    <SolidColorBrush x:Key="AureliaSidebar" Color="{StaticResource AureliaSidebarColor}" />
    <SolidColorBrush x:Key="AureliaSecondaryText" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="AureliaHairline" Color="#1FFFFFFF" />
  </Styles.Resources>

  <!-- Sidebar entries: quiet text, a soft pill when selected, like the Mac sidebar. -->
  <Style Selector="ListBox.sidebar">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="#D9FFFFFF" />
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#24FFFFFF" />
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>

  <!-- Text styles shared by every step. -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{StaticResource AureliaSecondaryText}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Quiet buttons: a soft capsule, a plain link, a list row and a profile tile. -->
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="#1FFFFFFF" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="18,9" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource AureliaSecondaryText}" />
  </Style>
  <Style Selector="Button.row">
    <Setter Property="Background" Value="#14FFFFFF" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.profile">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="8,12" />
  </Style>

  <!-- Library text: the small line above a hero title, shelf and page headings, card captions. -->
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Foreground" Value="#B3FFFFFF" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.page">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource AureliaSecondaryText}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Cards lift slightly under the pointer instead of drawing a button frame. -->
  <Style Selector="Button.card">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.card:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.03)" />
  </Style>
  <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.episode">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.round">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="#73000000" />
  </Style>
  <Style Selector="ProgressBar.card">
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="#59FFFFFF" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <!-- Player: quiet pills over the picture, a white play button and a slim timeline. -->
  <Style Selector="Button.pill">
    <Setter Property="Background" Value="#80000000" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.play">
    <Setter Property="Width" Value="64" />
    <Setter Property="Height" Value="64" />
    <Setter Property="CornerRadius" Value="32" />
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="Black" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#E6FFFFFF" />
  </Style>
  <Style Selector="Arc.spinner">
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Setup choices: a raised card for the recommended way, a quieter one for the other. -->
  <Style Selector="Button.choice">
    <Setter Property="Background" Value="#2EFFFFFF" />
    <Setter Property="BorderBrush" Value="#2EFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.choice.quiet">
    <Setter Property="Background" Value="#12FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource AureliaHairline}" />
  </Style>
  <!-- Settings: a grouped surface like the Mac's settings sections. -->
  <Style Selector="Border.group">
    <Setter Property="Background" Value="#12FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource AureliaHairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18,14" />
  </Style>

  <!-- The white capsule primary button of the Mac app. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="Black" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="22,9" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#61FFFFFF" />
    <Setter Property="Foreground" Value="#99000000" />
  </Style>
</Styles>
