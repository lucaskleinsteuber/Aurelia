<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <Copyright>Copyright (c) 2026 Lucas Kleinsteuber</Copyright>
    <TarvenBuildNumber>180</TarvenBuildNumber>
    <Version>3.0.0</Version>
    <FileVersion>3.0.0.$(TarvenBuildNumber)</FileVersion>
    <InformationalVersion>3.0.0+build.$(TarvenBuildNumber)</InformationalVersion>
    <!-- Generated output goes to the git-ignored Local folder unless TARVEN_OTHER_ROOT is set. -->
    <TarvenOtherRoot Condition="'$(TARVEN_OTHER_ROOT)' == ''">$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'Local'))</TarvenOtherRoot>
    <TarvenOtherRoot Condition="'$(TARVEN_OTHER_ROOT)' != ''">$(TARVEN_OTHER_ROOT)</TarvenOtherRoot>
    <TarvenBuildRoot Condition="'$(TARVEN_BUILD_ROOT)' == ''">$([System.IO.Path]::Combine('$(TarvenOtherRoot)', 'Build'))</TarvenBuildRoot>
    <TarvenBuildRoot Condition="'$(TARVEN_BUILD_ROOT)' != ''">$(TARVEN_BUILD_ROOT)</TarvenBuildRoot>
    <RestorePackagesPath Condition="'$(NUGET_PACKAGES)' == ''">$([System.IO.Path]::Combine('$(TarvenOtherRoot)', 'Package Cache', 'NuGet'))</RestorePackagesPath>
    <BaseOutputPath>$([System.IO.Path]::Combine('$(TarvenBuildRoot)', 'bin', '$(MSBuildProjectName)'))/</BaseOutputPath>
    <BaseIntermediateOutputPath>$([System.IO.Path]::Combine('$(TarvenBuildRoot)', 'obj', '$(MSBuildProjectName)'))/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <VSTestResultsDirectory>$([System.IO.Path]::Combine('$(TarvenOtherRoot)', 'Test Results'))</VSTestResultsDirectory>
  </PropertyGroup>
</Project>
