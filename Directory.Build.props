<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AureliaBuildNumber>62</AureliaBuildNumber>
    <Version>1.6.6</Version>
    <FileVersion>1.6.6.$(AureliaBuildNumber)</FileVersion>
    <InformationalVersion>1.6.6+build.$(AureliaBuildNumber)</InformationalVersion>
    <AureliaOtherRoot Condition="'$(AURELIA_OTHER_ROOT)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$([System.IO.Path]::Combine('$(HOME)', 'Library', 'Caches', 'Aurelia', 'Artifacts'))</AureliaOtherRoot>
    <AureliaOtherRoot Condition="'$(AURELIA_OTHER_ROOT)' == '' and '$(AureliaOtherRoot)' == ''">$([System.IO.Path]::Combine($([System.Environment]::GetFolderPath(SpecialFolder.UserProfile)), '.cache', 'Aurelia', 'Artifacts'))</AureliaOtherRoot>
    <AureliaOtherRoot Condition="'$(AURELIA_OTHER_ROOT)' == '' and '$(XDG_CACHE_HOME)' != '' and !$([MSBuild]::IsOSPlatform('OSX'))">$([System.IO.Path]::Combine('$(XDG_CACHE_HOME)', 'Aurelia', 'Artifacts'))</AureliaOtherRoot>
    <AureliaOtherRoot Condition="'$(AURELIA_OTHER_ROOT)' != ''">$(AURELIA_OTHER_ROOT)</AureliaOtherRoot>
    <AureliaBuildRoot Condition="'$(AURELIA_BUILD_ROOT)' == ''">$([System.IO.Path]::Combine('$(AureliaOtherRoot)', 'Build'))</AureliaBuildRoot>
    <AureliaBuildRoot Condition="'$(AURELIA_BUILD_ROOT)' != ''">$(AURELIA_BUILD_ROOT)</AureliaBuildRoot>
    <RestorePackagesPath Condition="'$(NUGET_PACKAGES)' == ''">$([System.IO.Path]::Combine('$(AureliaOtherRoot)', 'Package Cache', 'NuGet'))</RestorePackagesPath>
    <BaseOutputPath>$([System.IO.Path]::Combine('$(AureliaBuildRoot)', 'bin', '$(MSBuildProjectName)'))/</BaseOutputPath>
    <BaseIntermediateOutputPath>$([System.IO.Path]::Combine('$(AureliaBuildRoot)', 'obj', '$(MSBuildProjectName)'))/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <VSTestResultsDirectory>$([System.IO.Path]::Combine('$(AureliaOtherRoot)', 'Test Results'))</VSTestResultsDirectory>
  </PropertyGroup>
</Project>
