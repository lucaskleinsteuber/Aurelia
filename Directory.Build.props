<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AureliaBuildNumber>28</AureliaBuildNumber>
    <Version>1.1.2</Version>
    <FileVersion>1.1.2.$(AureliaBuildNumber)</FileVersion>
    <InformationalVersion>1.1.2+build.$(AureliaBuildNumber)</InformationalVersion>
    <AureliaOtherRoot Condition="'$(AURELIA_OTHER_ROOT)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../Aurelia Other'))</AureliaOtherRoot>
    <AureliaOtherRoot Condition="'$(AURELIA_OTHER_ROOT)' != ''">$(AURELIA_OTHER_ROOT)</AureliaOtherRoot>
    <AureliaBuildRoot Condition="'$(AURELIA_BUILD_ROOT)' == ''">$([System.IO.Path]::Combine('$(AureliaOtherRoot)', 'Build'))</AureliaBuildRoot>
    <RestorePackagesPath Condition="'$(NUGET_PACKAGES)' == ''">$([System.IO.Path]::Combine('$(AureliaOtherRoot)', 'Package Cache', 'NuGet'))</RestorePackagesPath>
    <BaseOutputPath>$([System.IO.Path]::Combine('$(AureliaBuildRoot)', 'bin', '$(MSBuildProjectName)'))/</BaseOutputPath>
    <BaseIntermediateOutputPath>$([System.IO.Path]::Combine('$(AureliaBuildRoot)', 'obj', '$(MSBuildProjectName)'))/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <VSTestResultsDirectory>$([System.IO.Path]::Combine('$(AureliaOtherRoot)', 'Test Results'))</VSTestResultsDirectory>
  </PropertyGroup>
</Project>
