<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <Copyright>Copyright (c) 2026 Lucas Kleinsteuber</Copyright>
    <AureliaBuildNumber>154</AureliaBuildNumber>
    <Version>2.5.0</Version>
    <FileVersion>2.5.0.$(AureliaBuildNumber)</FileVersion>
    <InformationalVersion>2.5.0+build.$(AureliaBuildNumber)</InformationalVersion>
    <!-- Generated output goes to the git-ignored Local folder unless AURELIA_OTHER_ROOT is set. -->
    <AureliaOtherRoot Condition="'$(AURELIA_OTHER_ROOT)' == ''">$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'Local'))</AureliaOtherRoot>
    <AureliaOtherRoot Condition="'$(AURELIA_OTHER_ROOT)' != ''">$(AURELIA_OTHER_ROOT)</AureliaOtherRoot>
    <AureliaBuildRoot Condition="'$(AURELIA_BUILD_ROOT)' == ''">$([System.IO.Path]::Combine('$(AureliaOtherRoot)', 'Build'))</AureliaBuildRoot>
    <AureliaBuildRoot Condition="'$(AURELIA_BUILD_ROOT)' != ''">$(AURELIA_BUILD_ROOT)</AureliaBuildRoot>
    <RestorePackagesPath Condition="'$(NUGET_PACKAGES)' == ''">$([System.IO.Path]::Combine('$(AureliaOtherRoot)', 'Package Cache', 'NuGet'))</RestorePackagesPath>
    <BaseOutputPath>$([System.IO.Path]::Combine('$(AureliaBuildRoot)', 'bin', '$(MSBuildProjectName)'))/</BaseOutputPath>
    <BaseIntermediateOutputPath>$([System.IO.Path]::Combine('$(AureliaBuildRoot)', 'obj', '$(MSBuildProjectName)'))/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <VSTestResultsDirectory>$([System.IO.Path]::Combine('$(AureliaOtherRoot)', 'Test Results'))</VSTestResultsDirectory>
  </PropertyGroup>
</Project>
