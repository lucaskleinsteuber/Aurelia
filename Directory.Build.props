<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AureliaHomeBuildNumber>7</AureliaHomeBuildNumber>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.$(AureliaHomeBuildNumber)</FileVersion>
    <InformationalVersion>0.1.0+build.$(AureliaHomeBuildNumber)</InformationalVersion>
    <AureliaHomeOtherRoot Condition="'$(AURELIA_HOME_OTHER_ROOT)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../Aurelia Home Other'))</AureliaHomeOtherRoot>
    <AureliaHomeOtherRoot Condition="'$(AURELIA_HOME_OTHER_ROOT)' != ''">$(AURELIA_HOME_OTHER_ROOT)</AureliaHomeOtherRoot>
    <AureliaHomeBuildRoot Condition="'$(AURELIA_HOME_BUILD_ROOT)' == ''">$([System.IO.Path]::Combine('$(AureliaHomeOtherRoot)', 'Build'))</AureliaHomeBuildRoot>
    <RestorePackagesPath Condition="'$(NUGET_PACKAGES)' == ''">$([System.IO.Path]::Combine('$(AureliaHomeOtherRoot)', 'Package Cache', 'NuGet'))</RestorePackagesPath>
    <BaseOutputPath>$([System.IO.Path]::Combine('$(AureliaHomeBuildRoot)', 'bin', '$(MSBuildProjectName)'))/</BaseOutputPath>
    <BaseIntermediateOutputPath>$([System.IO.Path]::Combine('$(AureliaHomeBuildRoot)', 'obj', '$(MSBuildProjectName)'))/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <VSTestResultsDirectory>$([System.IO.Path]::Combine('$(AureliaHomeOtherRoot)', 'Test Results'))</VSTestResultsDirectory>
  </PropertyGroup>
</Project>
